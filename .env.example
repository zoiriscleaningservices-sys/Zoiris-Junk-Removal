# ============================================================================
# Zoiris Junk Removal — Phase 2 Environment Configuration (.env.example)
# Copy to .env for local or server runtime configuration.
#
# SECURITY RULE:
# - Variables prefixed PUBLIC_ are embedded into static HTML at Astro build time.
# - NEVER place private database keys, owner secrets, service-role tokens, or
#   storage credentials in PUBLIC_* variables.
# ============================================================================

# Canonical public website origin (no trailing slash)
SITE_URL=https://zoirisjunkremoval.com
PUBLIC_SITE_URL=https://zoirisjunkremoval.com

# ----------------------------------------------------------------------------
# 1. Public Static Website -> Private CRM API Connection (Build-time)
# Leave PUBLIC_API_BASE blank when the public site and CRM server share an origin
# (or reverse-proxy `/api/public/*`), or set to https://crm.zoirisjunkremoval.com
# when static HTML is hosted on Cloudflare Pages / Netlify / GitHub Pages.
# ----------------------------------------------------------------------------
PUBLIC_API_BASE=
PUBLIC_FORM_PROVIDER=zoiris-crm
PUBLIC_FORM_ENDPOINT=
PUBLIC_FORM_ALLOW_UPLOADS=true

# Optional public analytics / Search Console verification tag
PUBLIC_GA4_ID=
PUBLIC_GSC_VERIFICATION=

# Optional public Supabase client config (if routing directly to Supabase Edge Functions)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# 2. Private Owner Command Center & Built-In CRM Server (server/index.mjs)
# ----------------------------------------------------------------------------
ZOIRIS_HOST=127.0.0.1
ZOIRIS_PORT=4500
# Private vault directory outside `dist/` and `public/` (stores SQLite WAL DB,
# private customer originals, EXIF-stripped WebP previews, and backups)
ZOIRIS_DATA_DIR=.zoiris-private

# 32+ character master secret for HMAC media stream URLs & TOTP encryption at rest
# (auto-generated into .zoiris-private/server-secret.key with 0600 permissions if omitted)
ZOIRIS_SERVER_SECRET=

# One-time secret (>= 16 chars) required ONLY if provisioning the first owner via
# the browser setup screen instead of `npm run owner:provision`
OWNER_SETUP_SECRET=

# ----------------------------------------------------------------------------
# 3. Private Customer Media Storage Provider
# Options: local (default private vault) | supabase | r2 (Cloudflare R2 / S3)
# ----------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_BUCKET=customer-media

# Supabase Cloud Postgres + Private Storage (optional cloud backend)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 Private Object Storage (recommended zero-egress scale option: 10 GB free)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# ----------------------------------------------------------------------------
# 4. Owner Lead Notifications (Server-side only — optional)
# In-dashboard real-time SSE notifications work immediately with zero external keys.
# ----------------------------------------------------------------------------
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=alerts@zoirisjunkremoval.com
EMAIL_NOTIFICATION_ADDRESS=

SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
SMS_NOTIFICATION_TO=

# ----------------------------------------------------------------------------
# 5. Google Analytics 4 Data API & Search Console API (Server-side only — optional)
# CSV import in /owner/search-performance/ works anytime without API credentials.
# ----------------------------------------------------------------------------
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_SEARCH_CONSOLE_PROPERTY=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ----------------------------------------------------------------------------
# 6. Legacy Local Content Studio (admin/server.mjs — optional local dev utility)
# ----------------------------------------------------------------------------
ADMIN_PORT=4400
ADMIN_TOKEN=
