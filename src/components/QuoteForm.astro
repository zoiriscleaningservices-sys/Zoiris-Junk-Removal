    const busy = (on: boolean) => (addrSpinner.hidden = !on);
    const closeList = () => {
      addrList.hidden = true;
      addrInput.setAttribute('aria-expanded', 'false');
      addrInput.removeAttribute('aria-activedescendant');
      activeIdx = -1;
    };
    const renderList = (items: Suggestion[], emptyText = '') => {
      suggestions = items;
      activeIdx = -1;
      if (!items.length && !emptyText) return closeList();
      addrList.innerHTML = items.length
        ? items
            .map(
              (s, i) =>
                `<li role="option" id="${id}-opt-${i}" data-opt="${i}" aria-selected="false"><span class="pf-opt-pin" aria-hidden="true">📍</span><span><strong>${esc(s.line)}</strong><small>${esc([s.city, `${s.state} ${s.zip}`.trim()].filter(Boolean).join(', '))}</small></span></li>`
