    const renderMedia = () => {
      const photos = queuedMedia.filter((m) => m.kind === 'photo').length;
      const videos = queuedMedia.filter((m) => m.kind === 'video').length;
      $('[data-photo-count]')!.textContent = String(photos);
      $('[data-video-count]')!.textContent = String(videos);
      mediaGrid.innerHTML = queuedMedia
        .map(
          (m) => `<li class="pf-thumb pf-thumb--${m.state}" data-media-uid="${m.uid}">
            ${m.kind === 'photo' ? `<img src="${m.previewUrl}" alt="${esc(m.file.name)}">` : `<video src="${m.previewUrl}" muted playsinline preload="metadata"></video><span class="pf-thumb__play" aria-hidden="true">▶</span>`}
            <span class="pf-thumb__meta">${m.kind === 'photo' ? 'Photo' : 'Video'} · ${fmtBytes(m.file.size)}</span>
            ${m.state === 'uploading' ? `<span class="pf-thumb__bar"><span data-bar="${m.uid}" style="width:${m.progress}%"></span></span>` : ''}
            ${m.state === 'uploaded' ? '<span class="pf-thumb__ok" aria-label="Uploaded">✓</span>' : ''}
            ${m.state === 'failed' ? `<button type="button" class="pf-thumb__retry" data-retry="${m.uid}">Retry</button>` : ''}
            ${m.state === 'ready' || m.state === 'failed' ? `<button type="button" class="pf-thumb__x" data-remove="${m.uid}" aria-label="Remove ${esc(m.file.name)}">×</button>` : ''}
          </li>`
        )
        .join('');
      updateNextLabel();
    };

    mediaGrid.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const rm = t.closest<HTMLElement>('[data-remove]');
      if (rm) {
        const i = queuedMedia.findIndex((m) => m.uid === rm.dataset.remove);
        if (i >= 0) {
          URL.revokeObjectURL(queuedMedia[i].previewUrl);
          queuedMedia.splice(i, 1);
          renderMedia();
        }
      }
      const rt = t.closest<HTMLElement>('[data-retry]');
      if (rt && savedInquiry) {
        const item = queuedMedia.find((m) => m.uid === rt.dataset.retry);
        if (item)
          uploadOne(item, savedInquiry.uploadToken).then((ok) => {
            if (ok && queuedMedia.every((m) => m.state === 'uploaded')) void finalize();
          });
      }
    });

    const addFiles = (files: FileList | File[]) => {
      const errors: string[] = [];
      for (const file of Array.from(files)) {
        const isVideo = file.type.startsWith('video/') || /\.(mp4|mov|webm|m4v)$/i.test(file.name);
        const isPhoto = file.type.startsWith('image/') || /\.(jpe?g|png|webp|heic|heif)$/i.test(file.name);
        if (!isVideo && !isPhoto) {
          errors.push(`"${file.name}" isn't a photo or video.`);
          continue;
        }
        const kind = isVideo ? 'video' : 'photo';
        const count = queuedMedia.filter((m) => m.kind === kind).length;
        if (kind === 'photo' && count >= limits.maxPhotos) {
          errors.push(`You can add up to ${limits.maxPhotos} photos.`);
          continue;
        }
        if (kind === 'video' && count >= limits.maxVideos) {
          errors.push(`You can add up to ${limits.maxVideos} videos.`);
          continue;
        }
        const max = kind === 'photo' ? limits.maxPhotoBytes : limits.maxVideoBytes;
        if (file.size > max) {
          errors.push(`"${file.name}" is ${fmtBytes(file.size)} — the ${kind} limit is ${fmtBytes(max)}.`);
          continue;
        }
        queuedMedia.push({ uid: `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`, file, kind, previewUrl: URL.createObjectURL(file), progress: 0, state: 'ready' });
      }
      mediaErr.textContent = errors.join(' ');
      renderMedia();
