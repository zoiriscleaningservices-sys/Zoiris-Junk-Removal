---
/**
 * Pickup Request Flow (`QuoteForm.astro`) — mobile-first, 4 simple steps.
 *
 *  1. What needs to go?   Big tap tiles + item chips + a "how much" truck meter
 *  2. Show us             Optional photos / videos straight from the phone camera
 *  3. Where's the pickup? Real-address search (OpenStreetMap suggestions + U.S. Census
 *                         verification, "use my location"), map preview, access + timing
 *  4. Your details        Name, phone, contact preference, review ticket, consent, send
 *
 * Protection: honeypot, human-timing signal, server-side phone/email/spam screening and
 * address verification (see server/spam-guard.mjs + server/geo.mjs). Nothing is ever
 * shown as booked — the owner confirms every pickup personally.
 */
import Icon from './Icon.astro';
import { integrations } from '../config/integrations.ts';

interface Props {
  id?: string;
  compact?: boolean;
}
const { id = 'pickup-form', compact = false } = Astro.props;
const f = integrations.form;
const relay = integrations.cloudRelay;

const CATEGORIES = [
  { key: 'Furniture', label: 'Furniture', hint: 'Couches, beds, tables', icon: 'sofa', items: ['Couches', 'Chairs', 'Tables', 'Mattresses', 'Bed frames', 'Desks', 'Dressers', 'Cabinets'] },
  { key: 'Appliances', label: 'Appliances', hint: 'Fridges, washers, stoves', icon: 'fridge', items: ['Refrigerators', 'Washers', 'Dryers', 'Stoves', 'Dishwashers', 'Other appliances'] },
  {
    key: 'Electronics',
    label: 'Electronics',
    hint: 'TVs, computers, e-waste',
    icon: 'laptop',
    items: ['Televisions', 'Monitors', 'Desktop computers', 'Laptops', 'Printers', 'Copiers', 'Phones', 'Tablets', 'Servers', 'Networking equipment', 'Gaming equipment', 'Cables', 'Batteries or battery-containing devices (confirmation required)']
  },
  { key: 'Cleanout', label: 'Cleanout', hint: 'Garage, house, estate', icon: 'garage', items: ['Garage contents', 'Whole house', 'Apartment', 'Estate', 'Office equipment', 'Storage unit'] },
  { key: 'Household', label: 'Household junk', hint: 'Boxes, bags, clutter', icon: 'boxes', items: ['Household junk', 'Boxes and bags', 'Exercise equipment', 'Toys and decor', 'Grills and patio items', 'Construction-related debris (subject to acceptance)'] },
  { key: 'Other', label: 'Something else', hint: 'Tell us in your words', icon: 'sparkle', items: [] as string[] }
];

const LOADS = [
  { value: '1–2 items', label: '1–2 items', sub: 'A single piece or two', load: 0.14 },
  { value: '3–5 items', label: 'A few items', sub: 'About 3–5 pieces', load: 0.3 },
  { value: 'Pickup-truck load', label: 'Pickup-truck load', sub: 'Fills a pickup bed', load: 0.5 },
  { value: 'Half truck', label: 'Half our truck', sub: 'A room or garage corner', load: 0.72 },
  { value: 'Full truck or more', label: 'Full truck +', sub: 'Whole garage or house', load: 1 },
  { value: 'Not sure', label: 'Not sure', sub: "We'll estimate from photos", load: 0.4 }
];

const WHERE = ['Curbside / driveway', 'Garage / carport', 'Inside – ground floor', 'Inside – upstairs', 'Backyard / shed', 'Storage unit'];
const STEPS = [
  { n: 1, short: 'Items', title: 'What needs to go?', sub: 'Tap everything that applies — you can pick more than one.' },
  { n: 2, short: 'Photos', title: 'Show us (optional)', sub: 'Photos or a quick video help us give you a faster, more accurate estimate.' },
  { n: 3, short: 'Address', title: 'Where is the pickup?', sub: 'Start typing and choose your address. We check every address is real.' },
  { n: 4, short: 'You', title: 'How do we reach you?', sub: 'Last step. We will call or text to confirm — nothing is booked yet.' }
];
---

<div class:list={['pf', compact && 'pf--compact']} data-pf={id}>
  <div class="pf-top" data-pf-top>
    <ol class="pf-progress" aria-label="Pickup request progress">
      {
        STEPS.map((s) => (
          <li class="pf-progress__seg" data-pf-seg={s.n} aria-current={s.n === 1 ? 'step' : undefined}>
            <span class="pf-progress__bar" aria-hidden="true">
              <span />
            </span>
            <span class="pf-progress__label">{s.short}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="pf-restored" data-pf-restored hidden>
    <Icon name="check-circle" /> We saved your progress.
    <button type="button" class="pf-link" data-pf-reset>Start over</button>
  </p>

  <form
    class="pf-form"
    id={id}
    novalidate
    method="post"
    action={f.endpoint ?? undefined}
    data-quote-form
    data-provider={f.provider}
    data-endpoint={f.endpoint ?? ''}
    data-upload-config-endpoint={f.uploadConfigEndpoint}
    data-upload-endpoint={f.uploadEndpoint}
    data-upload-complete-endpoint={f.uploadCompleteEndpoint}
    data-suggest-endpoint={f.addressSuggestEndpoint}
    data-verify-endpoint={f.addressVerifyEndpoint}
    data-reverse-endpoint={f.addressReverseEndpoint}
    data-cloud-relay={relay.enabledByBuild ? '1' : '0'}
    data-cloud-bridge={relay.cloudBridgeUrl}
    data-relay-url={relay.relayUrl}
    data-relay-topic={relay.topic}
    data-relay-pubkey={relay.publicKeySpkiB64}
    data-relay-click={relay.ownerClickUrl}
  >
    <div class="hp-field" aria-hidden="true">
      <label for={`${id}-gotcha`}>Leave this field empty</label>
      <input id={`${id}-gotcha`} name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="requestedService" value="Junk Removal" />

    {/* ================= STEP 1 — ITEMS ================= */}
    <section class="pf-pane" data-step-pane="1" aria-labelledby={`${id}-h1`}>
      <header class="pf-pane__head">
        <span class="pf-eyebrow">Step 1 of 4</span>
        <h2 id={`${id}-h1`} tabindex="-1">{STEPS[0].title}</h2>
        <p>{STEPS[0].sub}</p>
      </header>

      <fieldset class="pf-tiles">
        <legend class="sr-only">Type of items</legend>
        {
          CATEGORIES.map((c) => (
            <div class="pf-tile">
              <input type="checkbox" id={`${id}-cat-${c.key}`} name="category" value={c.key} />
              <label for={`${id}-cat-${c.key}`}>
                <span class="pf-tile__icon">
                  <Icon name={c.icon} />
                </span>
                <span class="pf-tile__label">{c.label}</span>
                <span class="pf-tile__hint">{c.hint}</span>
                <span class="pf-tile__check" aria-hidden="true">
                  <Icon name="check" />
                </span>
              </label>
            </div>
          ))
        }
      </fieldset>

      {
        CATEGORIES.filter((c) => c.items.length).map((c) => (
          <fieldset class="pf-chips" data-chips-for={c.key} hidden>
            <legend>
              {c.label}: <span>which ones?</span>
            </legend>
            <div class="pf-chips__row">
              {c.items.map((item, i) => (
                <span class="pf-chip">
                  <input type="checkbox" id={`${id}-item-${c.key}-${i}`} name="selectedItem" value={item} data-category={c.key === 'Cleanout' || c.key === 'Household' ? 'Other' : c.key} />
                  <label for={`${id}-item-${c.key}-${i}`}>{item.replace(' (confirmation required)', ' — we confirm first').replace(' (subject to acceptance)', ' — we confirm first')}</label>
                </span>
              ))}
            </div>
          </fieldset>
        ))
      }

      <div class="pf-field" data-other-wrap>
        <label for={`${id}-otherItemDescription`}>Anything else? <span class="pf-opt">optional</span></label>
        <input id={`${id}-otherItemDescription`} name="otherItemDescription" type="text" maxlength="300" placeholder="e.g. old piano, hot tub, swing set" autocomplete="off" />
      </div>
      <p class="pf-error" id={`${id}-items-err`} role="alert"></p>

      <fieldset class="pf-load">
        <legend>About how much is there?</legend>
        <div class="pf-truck" aria-hidden="true" style="--load: 0">
          <svg viewBox="0 0 220 96" focusable="false">
            <defs>
              <clipPath id={`${id}-cargo`}>
                <rect x="8" y="10" width="132" height="58" rx="6"></rect>
              </clipPath>
            </defs>
            <rect x="8" y="10" width="132" height="58" rx="6" class="pf-truck__box"></rect>
            <g clip-path={`url(#${id}-cargo)`}>
              <rect x="8" y="10" width="132" height="58" class="pf-truck__fill"></rect>
            </g>
            <path d="M144 30h34l22 20v18h-56z" class="pf-truck__cab"></path>
            <path d="M152 36h22l14 13h-36z" class="pf-truck__glass"></path>
            <rect x="4" y="66" width="204" height="6" rx="3" class="pf-truck__base"></rect>
            <circle cx="42" cy="78" r="11" class="pf-truck__wheel"></circle>
            <circle cx="172" cy="78" r="11" class="pf-truck__wheel"></circle>
            <circle cx="42" cy="78" r="4" class="pf-truck__hub"></circle>
            <circle cx="172" cy="78" r="4" class="pf-truck__hub"></circle>
            <path d="M28 24h50M28 34h34" class="pf-truck__logo"></path>
          </svg>
          <span class="pf-truck__label" data-truck-label>Pick a size</span>
        </div>
        <div class="pf-load__opts">
          {
            LOADS.map((l, i) => (
              <span class="pf-load__opt">
                <input type="radio" id={`${id}-load-${i}`} name="estimatedQuantity" value={l.value} data-load={l.load} />
                <label for={`${id}-load-${i}`}>
                  <strong>{l.label}</strong>
                  <small>{l.sub}</small>
                </label>
              </span>
            ))
          }
        </div>
        <p class="pf-error" id={`${id}-estimatedQuantity-err`} role="alert"></p>
      </fieldset>
    </section>

    {/* ================= STEP 2 — PHOTOS ================= */}
    <section class="pf-pane" data-step-pane="2" aria-labelledby={`${id}-h2`} hidden>
      <header class="pf-pane__head">
        <span class="pf-eyebrow">Step 2 of 4</span>
        <h2 id={`${id}-h2`} tabindex="-1">{STEPS[1].title}</h2>
        <p>{STEPS[1].sub}</p>
      </header>

      <div class="pf-media" data-dropzone>
        <div class="pf-media__buttons">
          <label class="pf-bigbtn pf-bigbtn--primary" for={`${id}-camera`}>
            <Icon name="camera" />
            <span><strong>Take photo or video</strong><small>Opens your camera</small></span>
          </label>
          <label class="pf-bigbtn" for={`${id}-media-picker`}>
            <Icon name="boxes" />
            <span><strong>Choose from phone</strong><small>Photos &amp; videos</small></span>
          </label>
        </div>
        <input class="sr-only" id={`${id}-camera`} type="file" accept="image/*,video/*" capture="environment" data-media-input tabindex="-1" />
        <input class="sr-only" id={`${id}-media-picker`} type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif,video/mp4,video/quicktime,video/webm" multiple data-media-input tabindex="-1" />
        <p class="pf-media__drop">or drag &amp; drop files here</p>
        <p class="pf-media__counts">
          <span><strong data-photo-count>0</strong> photo(s)</span>
          <span><strong data-video-count>0</strong> video(s)</span>
          <span class="pf-media__limits" data-media-limits>Up to 12 photos &amp; 3 videos</span>
        </p>
        <ul class="pf-media__grid" data-media-grid aria-live="polite"></ul>
        <p class="pf-error" data-media-error role="alert"></p>
      </div>

      <div class="pf-tips">
        <Icon name="sparkle" />
        <p><strong>Tip:</strong> one wide shot of everything, plus close-ups of big or heavy items. A 10-second walk-through video works great.</p>
      </div>

      <div class="pf-field">
        <label for={`${id}-itemDescription`}>Anything we should know about the items? <span class="pf-opt">optional</span></label>
        <textarea id={`${id}-itemDescription`} name="itemDescription" rows="3" maxlength="1500" placeholder="e.g. sectional couch comes apart in 3 pieces, fridge is still plugged in"></textarea>
      </div>
    </section>

    {/* ================= STEP 3 — ADDRESS ================= */}
    <section class="pf-pane" data-step-pane="3" aria-labelledby={`${id}-h3`} hidden>
      <header class="pf-pane__head">
        <span class="pf-eyebrow">Step 3 of 4</span>
        <h2 id={`${id}-h3`} tabindex="-1">{STEPS[2].title}</h2>
        <p>{STEPS[2].sub}</p>
      </header>

      <div class="pf-addr" data-address-search>
        <label class="pf-addr__label" for={`${id}-address`}>Pickup address</label>
        <div class="pf-addr__box">
          <Icon name="pin" />
          <input
            id={`${id}-address`}
            name="addressSearch"
            type="text"
            inputmode="text"
            autocomplete="street-address"
            placeholder="Start typing any U.S. street address…"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls={`${id}-address-list`}
            aria-describedby={`${id}-pickupAddress-err`}
          />
          <span class="pf-spinner" data-address-spinner hidden aria-hidden="true"></span>
        </div>
        <ul class="pf-addr__list" id={`${id}-address-list`} role="listbox" aria-label="Matching addresses" data-address-list hidden></ul>
        <div class="pf-addr__actions">
          <button type="button" class="pf-pill" data-address-locate><Icon name="pin" /> Use my current location</button>
          <button type="button" class="pf-pill" data-address-check><Icon name="check" /> Check this address</button>
        </div>
        <p class="pf-addr__note"><Icon name="shield" /> Verified against official U.S. street &amp; parcel databases and pinned live on the map.</p>
      </div>

      <div class="pf-verified" data-address-card hidden>
        <div class="pf-map" data-map role="region" aria-label="Verified pickup address map">
          <div class="pf-map__tiles" data-map-tiles></div>
          <span class="pf-map__pin" data-map-pin aria-hidden="true"><Icon name="pin" /></span>
          <div class="pf-map__toggle" role="group" aria-label="Map style">
            <button type="button" data-map-layer="street" aria-pressed="true">Map</button>
            <button type="button" data-map-layer="satellite" aria-pressed="false">Satellite</button>
          </div>
          <div class="pf-map__zoom" role="group" aria-label="Map zoom">
            <button type="button" data-map-zoom="1" aria-label="Zoom in">+</button>
            <button type="button" data-map-zoom="-1" aria-label="Zoom out">&minus;</button>
            <button type="button" data-map-recenter hidden aria-label="Recenter on pin" title="Recenter on address pin">◎</button>
          </div>
          <span class="pf-map__attr" data-map-attr>© OpenStreetMap contributors</span>
        </div>
        <div class="pf-verified__body">
          <span class="pf-badge"><Icon name="check-circle" /> <span data-verified-badge>Verified address</span></span>
          <p class="pf-verified__addr" data-verified-text></p>
          <p class="pf-verified__county" data-verified-county></p>
          <div class="pf-verified__links">
            <button type="button" class="pf-link" data-address-change>Not right? Change address</button>
            <a class="pf-link pf-link--ext" data-verified-gmaps href="https://maps.google.com" target="_blank" rel="noopener">Open in Google Maps ↗</a>
          </div>
        </div>
      </div>

      <div class="pf-manual" data-manual-address hidden>
        <p class="pf-manual__note" data-manual-note>Type your address below.</p>
        <div class="pf-field">
          <label for={`${id}-pickupAddress`}>Street address</label>
          <input id={`${id}-pickupAddress`} name="pickupAddress" type="text" autocomplete="address-line1" maxlength="200" aria-describedby={`${id}-pickupAddress-err`} />
        </div>
        <div class="pf-grid3">
          <div class="pf-field">
            <label for={`${id}-city`}>City</label>
            <input id={`${id}-city`} name="city" type="text" autocomplete="address-level2" placeholder="City" value="Mobile" maxlength="80" />
            <p class="pf-error" id={`${id}-city-err`} role="alert"></p>
          </div>
          <div class="pf-field">
            <label for={`${id}-state`}>State</label>
            <input id={`${id}-state`} name="state" type="text" autocomplete="address-level1" placeholder="AL" value="AL" maxlength="2" />
            <p class="pf-error" id={`${id}-state-err`} role="alert"></p>
          </div>
          <div class="pf-field">
            <label for={`${id}-zipCode`}>ZIP code</label>
            <input id={`${id}-zipCode`} name="zipCode" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="10" />
            <p class="pf-error" id={`${id}-zipCode-err`} role="alert"></p>
          </div>
        </div>
      </div>
      <p class="pf-error" id={`${id}-pickupAddress-err`} role="alert"></p>

      <div class="pf-field">
        <label for={`${id}-addressUnit`}>Apt, suite, or gate # <span class="pf-opt">optional</span></label>
        <input id={`${id}-addressUnit`} name="addressUnit" type="text" autocomplete="address-line2" maxlength="40" />
      </div>

      <fieldset class="pf-choice">
        <legend>Where are the items?</legend>
        <div class="pf-choice__row">
          {
            WHERE.map((w, i) => (
              <span class="pf-chip pf-chip--radio">
                <input type="radio" id={`${id}-where-${i}`} name="indoorsOrOutdoors" value={w} />
                <label for={`${id}-where-${i}`}>{w}</label>
              </span>
            ))
          }
        </div>
        <p class="pf-error" id={`${id}-indoorsOrOutdoors-err`} role="alert"></p>
      </fieldset>

      <fieldset class="pf-choice" data-stairs-wrap hidden>
        <legend>Is there an elevator?</legend>
        <div class="pf-choice__row">
          <span class="pf-chip pf-chip--radio">
            <input type="radio" id={`${id}-stairs-0`} name="hasStairs" value="Stairs only" />
            <label for={`${id}-stairs-0`}>Stairs only</label>
          </span>
          <span class="pf-chip pf-chip--radio">
            <input type="radio" id={`${id}-stairs-1`} name="hasStairs" value="Elevator available" />
            <label for={`${id}-stairs-1`}>Elevator available</label>
          </span>
        </div>
      </fieldset>

      <fieldset class="pf-choice">
        <legend>When works for you?</legend>
        <div class="pf-choice__row">
          {
            ['As soon as possible', 'This week', 'Pick a date'].map((t, i) => (
              <span class="pf-chip pf-chip--radio">
                <input type="radio" id={`${id}-timing-${i}`} name="timing" value={t} checked={i === 0} />
                <label for={`${id}-timing-${i}`}>{t}</label>
              </span>
            ))
          }
        </div>
        <div class="pf-field" data-date-wrap hidden>
          <label for={`${id}-preferredDate`}>Preferred date</label>
          <input id={`${id}-preferredDate`} name="preferredDate" type="date" />
        </div>
        <div class="pf-choice__row pf-choice__row--small">
          {
            ['Morning', 'Afternoon', 'Flexible'].map((w, i) => (
              <span class="pf-chip pf-chip--radio">
                <input type="radio" id={`${id}-window-${i}`} name="preferredWindow" value={w} checked={i === 2} />
                <label for={`${id}-window-${i}`}>{w}</label>
              </span>
            ))
          }
        </div>
      </fieldset>

      <div class="pf-field">
        <label for={`${id}-accessInstructions`}>Gate code, parking or access notes <span class="pf-opt">optional</span></label>
        <textarea id={`${id}-accessInstructions`} name="accessInstructions" rows="2" maxlength="600" placeholder="e.g. side gate is unlocked, park in the driveway"></textarea>
      </div>
    </section>

    {/* ================= STEP 4 — YOU + REVIEW ================= */}
    <section class="pf-pane" data-step-pane="4" aria-labelledby={`${id}-h4`} hidden>
      <header class="pf-pane__head">
        <span class="pf-eyebrow">Step 4 of 4</span>
        <h2 id={`${id}-h4`} tabindex="-1">{STEPS[3].title}</h2>
        <p>{STEPS[3].sub}</p>
      </header>

      <div class="pf-seg" role="radiogroup" aria-label="Pickup is for">
        <span>
          <input type="radio" id={`${id}-type-res`} name="customerType" value="residential" checked />
          <label for={`${id}-type-res`}><Icon name="home" /> My home</label>
        </span>
        <span>
          <input type="radio" id={`${id}-type-com`} name="customerType" value="commercial" />
          <label for={`${id}-type-com`}><Icon name="building" /> A business</label>
        </span>
      </div>

      <div class="pf-grid2">
        <div class="pf-field">
          <label for={`${id}-firstName`}>First name</label>
          <input id={`${id}-firstName`} name="firstName" type="text" autocomplete="given-name" maxlength="80" aria-describedby={`${id}-firstName-err`} />
          <p class="pf-error" id={`${id}-firstName-err`} role="alert"></p>
        </div>
        <div class="pf-field">
          <label for={`${id}-lastName`}>Last name</label>
          <input id={`${id}-lastName`} name="lastName" type="text" autocomplete="family-name" maxlength="80" aria-describedby={`${id}-lastName-err`} />
          <p class="pf-error" id={`${id}-lastName-err`} role="alert"></p>
        </div>
      </div>
      <div class="pf-field">
        <label for={`${id}-phone`}>Mobile phone</label>
        <input id={`${id}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="(251) 555-0123" maxlength="20" aria-describedby={`${id}-phone-err`} />
        <p class="pf-error" id={`${id}-phone-err`} role="alert"></p>
      </div>
      <div class="pf-field">
        <label for={`${id}-email`}>Email <span class="pf-opt">optional</span></label>
        <input id={`${id}-email`} name="email" type="email" inputmode="email" autocomplete="email" maxlength="160" aria-describedby={`${id}-email-err`} />
        <p class="pf-error" id={`${id}-email-err`} role="alert"></p>
      </div>

      <fieldset class="pf-choice">
        <legend>Best way to reach you</legend>
        <div class="pf-choice__row">
          <span class="pf-chip pf-chip--radio">
            <input type="radio" id={`${id}-pc-phone`} name="preferredContact" value="phone" checked />
            <label for={`${id}-pc-phone`}><Icon name="call" /> Call</label>
          </span>
          <span class="pf-chip pf-chip--radio">
            <input type="radio" id={`${id}-pc-text`} name="preferredContact" value="text" />
            <label for={`${id}-pc-text`}><Icon name="phone" /> Text</label>
          </span>
          <span class="pf-chip pf-chip--radio">
            <input type="radio" id={`${id}-pc-email`} name="preferredContact" value="email" />
            <label for={`${id}-pc-email`}><Icon name="mail" /> Email</label>
          </span>
        </div>
      </fieldset>

      <div class="pf-ticket" data-review-summary aria-live="polite"></div>

      <div class="pf-consent">
        <input type="checkbox" id={`${id}-consentGiven`} name="consentGiven" aria-describedby={`${id}-consentGiven-err`} />
        <label for={`${id}-consentGiven`}>Zoiris Junk Removal may call or text me about this request. I understand nothing is booked until they confirm with me.</label>
      </div>
      <p class="pf-error" id={`${id}-consentGiven-err`} role="alert"></p>
    </section>

    <div class="form-status" role="status" aria-live="polite" tabindex="-1" hidden data-form-status></div>

    <div class="pf-actions" data-pf-actions>
      <button type="button" class="pf-btn pf-btn--ghost" data-pf-back hidden>
        <span aria-hidden="true">←</span> Back
      </button>
      <a class="pf-btn pf-btn--call" href="tel:+12519308621" data-track="call" data-track-location="pickup-form" aria-label="Call 251-930-8621 instead">
        <Icon name="call" />
      </a>
      <button type="button" class="pf-btn pf-btn--go" data-pf-next>
        <span data-pf-next-label>Continue</span> <span aria-hidden="true">→</span>
      </button>
      <button type="submit" class="pf-btn pf-btn--go" data-submit hidden>
        <span data-submit-label>Send my request</span>
      </button>
    </div>
  </form>

  <div class="pf-done" data-confirmation-panel tabindex="-1" hidden></div>
</div>

<script>
  type Verified = {
    line: string;
    city: string;
    state: string;
    zip: string;
    lat: number | null;
    lng: number | null;
    countyName: string;
    countyFips?: string;
    source?: string;
    token: string;
    status: string;
  };
  type Suggestion = {
    label: string;
    line: string;
    city: string;
    state: string;
    zip: string;
    lat?: number;
    lng?: number;
    countyName?: string;
    magicKey?: string;
    singleLine?: string;
  };
  type QueuedMedia = {
    uid: string;
    file: File;
    kind: 'photo' | 'video';
    previewUrl: string;
    progress: number;
    state: 'ready' | 'uploading' | 'uploaded' | 'failed';
    error?: string;
  };

  const PHONE = '251-930-8621';
  const TOTAL = 4;
  const DRAFT_KEY = 'zoiris-pickup-draft-v2';
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const esc = (v: unknown) =>
    String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
  const fmtBytes = (n: number) => (n < 1048576 ? `${Math.round(n / 1024)} KB` : `${(n / 1048576).toFixed(1)} MB`);

  async function postJson(url: string, body: unknown): Promise<{ ok: boolean; status: number; data: any }> {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(body)
    });
    const ct = res.headers.get('content-type') || '';
    if (!ct.includes('application/json')) return { ok: false, status: res.status, data: null };
    return { ok: res.ok, status: res.status, data: await res.json() };
  }

  /* -------- Live Nationwide U.S. Geocoding, Spam Guard & E2E Encryption (24/7 Mode) -------- */
  const DIRECTIONALS = new Set(['N', 'S', 'E', 'W', 'NE', 'NW', 'SE', 'SW']);
  const US_STATE_NAMES: Record<string, string> = {
    AL: 'Alabama', AK: 'Alaska', AZ: 'Arizona', AR: 'Arkansas', CA: 'California', CO: 'Colorado', CT: 'Connecticut',
    DE: 'Delaware', DC: 'District of Columbia', FL: 'Florida', GA: 'Georgia', HI: 'Hawaii', ID: 'Idaho', IL: 'Illinois',
    IN: 'Indiana', IA: 'Iowa', KS: 'Kansas', KY: 'Kentucky', LA: 'Louisiana', ME: 'Maine', MD: 'Maryland',
    MA: 'Massachusetts', MI: 'Michigan', MN: 'Minnesota', MS: 'Mississippi', MO: 'Missouri', MT: 'Montana',
    NE: 'Nebraska', NV: 'Nevada', NH: 'New Hampshire', NJ: 'New Jersey', NM: 'New Mexico', NY: 'New York',
    NC: 'North Carolina', ND: 'North Dakota', OH: 'Ohio', OK: 'Oklahoma', OR: 'Oregon', PA: 'Pennsylvania',
    RI: 'Rhode Island', SC: 'South Carolina', SD: 'South Dakota', TN: 'Tennessee', TX: 'Texas', UT: 'Utah',
    VT: 'Vermont', VA: 'Virginia', WA: 'Washington', WV: 'West Virginia', WI: 'Wisconsin', WY: 'Wyoming',
    PR: 'Puerto Rico', VI: 'U.S. Virgin Islands', GU: 'Guam', AS: 'American Samoa', MP: 'Northern Mariana Islands'
  };
  const US_STATE_BY_NAME: Record<string, string> = Object.fromEntries(
    Object.entries(US_STATE_NAMES).map(([abbr, full]) => [full.toLowerCase(), abbr])
  );
  const US_COUNTRY_CODES = new Set(['USA', 'US', 'PRI', 'VIR', 'GUM', 'ASM', 'MNP']);
  const ARCGIS_BASE = 'https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer';

  function normalizeUsState(raw = ''): string {
    const clean = String(raw || '').trim().replace(/\./g, '');
    if (!clean) return '';
    const up = clean.toUpperCase();
    if (US_STATE_NAMES[up]) return up;
    return US_STATE_BY_NAME[clean.toLowerCase()] || '';
  }

  function stateFullName(abbr = ''): string {
    const st = normalizeUsState(abbr);
    return US_STATE_NAMES[st] || abbr;
  }

  const DISPOSABLE_DOMAINS = new Set([
    'mailinator.com', 'guerrillamail.com', 'sharklasers.com', '10minutemail.com', 'tempmail.com', 'temp-mail.org',
    'yopmail.com', 'trashmail.com', 'getnada.com', 'maildrop.cc', 'throwawaymail.com', 'fakeinbox.com',
    'burnermail.io', 'mailnesia.com', 'inboxkitten.com', 'mail.tm', 'discard.email', 'fakemail.net', 'example.com', 'example.org', 'test.com'
  ]);
  const PROMO_PATTERNS = [
    /\bseo\b/i, /backlinks?/i, /guest\s*post/i, /first page of google/i, /rank(ing)? (higher|#?1)/i,
    /web\s*design/i, /website (redesign|traffic)/i, /digital marketing/i, /marketing (services|agency)/i,
    /lead generation/i, /crypto|bitcoin|forex|binary option/i, /casino|betting|viagra|cialis/i,
    /whats\s?app|telegram/i, /unsubscribe/i, /dear (sir|madam|business owner)/i
  ];
  const URL_RE = /(https?:\/\/|www\.|\b[a-z0-9-]+\.(com|net|org|io|ru|xyz|info|biz|top|site|online|shop)\b)/gi;
  const URL_TEST = new RegExp(URL_RE.source, 'i');

  function titleCaseAddr(s = '') {
    return String(s)
      .trim()
      .split(/\s+/)
      .filter(Boolean)
      .map((w) => {
        const up = w.toUpperCase();
        if (DIRECTIONALS.has(up) || /^\d/.test(w)) return up;
        return up.charAt(0) + up.slice(1).toLowerCase();
      })
      .join(' ');
  }

  function parseArcgisSuggestionText(rawText: string, magicKey = ''): Suggestion | null {
    const parts = String(rawText || '')
      .split(',')
      .map((p) => p.trim())
      .filter(Boolean);
    if (parts.length < 3) return null;
    const lastUp = parts[parts.length - 1].toUpperCase();
    if (US_COUNTRY_CODES.has(lastUp) || lastUp === 'UNITED STATES') parts.pop();
    let zip = '';
    if (parts.length && /^\d{5}(-\d{4})?$/.test(parts[parts.length - 1])) {
      zip = parts.pop()!.slice(0, 5);
    }
    let state = '';
    if (parts.length) {
      const stMaybe = parts[parts.length - 1];
      const stZipMatch = stMaybe.match(/^([A-Za-z]{2})\s+(\d{5})/);
      if (stZipMatch) {
        state = normalizeUsState(stZipMatch[1]);
        if (!zip) zip = stZipMatch[2];
        parts.pop();
      } else {
        const norm = normalizeUsState(stMaybe);
        if (norm) {
          state = norm;
          parts.pop();
        }
      }
    }
    if (!state || parts.length < 2) return null;
    const city = parts.pop() || '';
    const line = parts.join(', ').trim();
    if (!/^\d{1,6}[A-Za-z]?(?:-\d+)?\b/.test(line)) return null;
    const label = [line, city, `${state}${zip ? ' ' + zip : ''}`].filter(Boolean).join(', ');
    return { label, line, city, state, zip, magicKey: magicKey || undefined, singleLine: rawText };
  }

  function arcgisCandidateToAddress(cand: any, typedNumber = '') {
    const a = cand?.attributes || {};
    const loc = cand?.location || {};
    const country = String(a.Country || 'USA').toUpperCase();
    if (country && !US_COUNTRY_CODES.has(country)) return null;
    const score = Number(cand?.score ?? a.Score ?? 0);
    const addrType = String(a.Addr_type || '');
    if (score < 82 || !['PointAddress', 'Subaddress', 'StreetAddress'].includes(addrType)) return null;
    const lat = Number(loc.y);
    const lng = Number(loc.x);
    if (!Number.isFinite(lat) || !Number.isFinite(lng)) return null;
    const stAddr = String(a.StAddr || '').trim();
    const addNum = String(a.AddNum || '').trim() || (stAddr.match(/^(\d+[A-Za-z]?)/) || [])[1] || '';
    if (!addNum) return null;
    if (typedNumber && addrType === 'StreetAddress' && addNum.replace(/\D/g, '') !== typedNumber.replace(/\D/g, '')) {
      return null;
    }
    const state = normalizeUsState(a.RegionAbbr || a.Region || '');
    if (!state) return null;
    const unit = [a.UnitType, a.UnitName].filter(Boolean).join(' ').trim();
    const fullLine = unit && !stAddr.toLowerCase().includes(unit.toLowerCase()) ? `${stAddr}, ${unit}` : stAddr;
    const city = String(a.City || '').trim();
    const zip = String(a.Postal || '').slice(0, 5);
    const countyName = String(a.Subregion || '').trim();
    const countyFips =
      state === 'AL' && /^mobile/i.test(countyName)
        ? '01097'
        : state === 'AL' && /^baldwin/i.test(countyName)
          ? '01003'
          : '';
    return {
      line: fullLine || titleCaseAddr(`${addNum} ${a.StName || ''}`),
      city: city || titleCaseAddr(String(a.Match_addr || '').split(',')[1] || ''),
      state,
      zip,
      lat: Number(lat.toFixed(6)),
      lng: Number(lng.toFixed(6)),
      countyFips,
      countyName
    };
  }

  async function arcgisFindCandidates(singleLine: string, magicKey = '', maxLocations = 5): Promise<any[] | null> {
    const params: Record<string, string> = {
      f: 'json',
      SingleLine: singleLine,
      countryCode: 'USA',
      category: 'Point Address,Street Address,Subaddress',
      outFields: 'Match_addr,StAddr,UnitType,UnitName,AddNum,StName,City,Region,RegionAbbr,Subregion,Postal,Country,Addr_type,Score',
      maxLocations: String(maxLocations)
    };
    if (magicKey) params.magicKey = magicKey;
    const res = await fetch(`${ARCGIS_BASE}/findAddressCandidates?${new URLSearchParams(params).toString()}`, {
      headers: { Accept: 'application/json' }
    });
    if (!res.ok) return null;
    const data = await res.json();
    return Array.isArray(data?.candidates) ? data.candidates : [];
  }

  async function browserSuggest(rawQ: string): Promise<Suggestion[] | null> {
    const q = rawQ.trim().slice(0, 140);
    if (q.length < 3) return [];
    const typedNumber = (q.match(/^\s*(\d{1,6}[A-Za-z]?)\b/) || [])[1] || '';
    const seen = new Set<string>();
    const out: Suggestion[] = [];
    let anyProviderOk = false;

    // 1. Primary Authoritative U.S. Autocomplete: Esri ArcGIS World Geocoder (all 50 states + DC)
    try {
      const sUrl =
        `${ARCGIS_BASE}/suggest?` +
        new URLSearchParams({
          f: 'json',
          text: q,
          countryCode: 'USA',
          category: 'Point Address,Street Address,Subaddress',
          maxSuggestions: '7'
        }).toString();
      const sRes = await fetch(sUrl, { headers: { Accept: 'application/json' } });
      if (sRes.ok) {
        anyProviderOk = true;
        const sData = await sRes.json();
        for (const item of sData?.suggestions || []) {
          if (item?.isCollection) continue;
          const parsed = parseArcgisSuggestionText(item.text || '', item.magicKey || '');
          if (!parsed) continue;
          const key = `${parsed.line}|${parsed.city}|${parsed.state}`.toLowerCase();
          if (seen.has(key)) continue;
          seen.add(key);
          out.push(parsed);
          if (out.length >= 7) break;
        }
      }

      // Highway / postal-city alias fallback (e.g. "12405 US Hwy 98, Fairhope, AL")
      if (!out.length && typedNumber && q.length >= 6) {
        const cands = await arcgisFindCandidates(q, '', 5);
        if (cands) {
          anyProviderOk = true;
          for (const c of cands) {
            const addr = arcgisCandidateToAddress(c, typedNumber);
            if (!addr) continue;
            const key = `${addr.line}|${addr.city}|${addr.state}`.toLowerCase();
            if (seen.has(key)) continue;
            seen.add(key);
            const label = [addr.line, addr.city, `${addr.state}${addr.zip ? ' ' + addr.zip : ''}`].filter(Boolean).join(', ');
            out.push({
              label,
              line: addr.line,
              city: addr.city,
              state: addr.state,
              zip: addr.zip,
              lat: addr.lat,
              lng: addr.lng,
              countyName: addr.countyName,
              singleLine: label
            });
            if (out.length >= 6) break;
          }
        }
      }
    } catch {}

    if (out.length) return out;

    // 2. Nationwide OpenStreetMap Photon fallback (all U.S. states, zero bbox lockout)
    try {
      const pRes = await fetch(
        'https://photon.komoot.io/api/?' + new URLSearchParams({ q, limit: '10', lang: 'en' }).toString(),
        { headers: { Accept: 'application/json' } }
      );
      if (pRes.ok) {
        anyProviderOk = true;
        const pData = await pRes.json();
        for (const f of pData.features || []) {
          const p = f.properties || {};
          const [lng, lat] = f.geometry?.coordinates || [];
          if (String(p.countrycode || '').toUpperCase() !== 'US') continue;
          if (typeof lat !== 'number' || typeof lng !== 'number') continue;
          const streetName = p.street || (p.osm_key === 'highway' || p.type === 'street' ? p.name : '');
          if (!streetName) continue;
          if (typedNumber && p.housenumber && String(p.housenumber) !== typedNumber) continue;
          const number = p.housenumber || typedNumber;
          if (!number) continue;
          const state = normalizeUsState(p.state || '');
          if (!state) continue;
          const line = `${number} ${titleCaseAddr(streetName)}`;
          const city = p.city || p.locality || p.town || p.village || p.district || '';
          const zip = p.postcode && /^\d{5}/.test(String(p.postcode)) ? String(p.postcode).slice(0, 5) : '';
          const label = [line, city, `${state}${zip ? ' ' + zip : ''}`].filter(Boolean).join(', ');
          const key = `${line}|${city}|${state}`.toLowerCase();
          if (seen.has(key)) continue;
          seen.add(key);
          out.push({
            label,
            line,
            city,
            state,
            zip,
            lat: Number(lat.toFixed(6)),
            lng: Number(lng.toFixed(6)),
            countyName: String(p.county || '').trim(),
            singleLine: label
          });
          if (out.length >= 6) break;
        }
      }
    } catch {}

    return anyProviderOk ? out : null;
  }

  async function browserReverse(lat: number, lng: number): Promise<{ suggestions: Suggestion[]; message?: string } | null> {
    const out: Suggestion[] = [];
    const seen = new Set<string>();
    let anyProviderOk = false;

    // 1. Esri ArcGIS Rooftop Reverse Geocoder (Nationwide U.S.)
    try {
      const rRes = await fetch(
        `${ARCGIS_BASE}/reverseGeocode?` +
          new URLSearchParams({
            f: 'json',
            location: `${lng},${lat}`,
            featureTypes: 'PointAddress,StreetAddress,Subaddress'
          }).toString(),
        { headers: { Accept: 'application/json' } }
      );
      if (rRes.ok) {
        anyProviderOk = true;
        const rData = await rRes.json();
        const a = rData?.address;
        if (a) {
          const cc = String(a.CountryCode || '').toUpperCase();
          if (cc && !US_COUNTRY_CODES.has(cc)) {
            return {
              suggestions: [],
              message: 'Your current location appears outside the United States. Please type a U.S. street address.'
            };
          }
          const state = normalizeUsState(a.RegionAbbr || a.Region || '');
          const line = String(a.Address || a.ShortLabel || '').trim();
          const city = String(a.City || '').trim();
          const zip = String(a.Postal || '').slice(0, 5);
          const rLat = Number(rData?.location?.y ?? lat);
          const rLng = Number(rData?.location?.x ?? lng);
          if (line && /^\d/.test(line) && state) {
            const label = [line, city, `${state}${zip ? ' ' + zip : ''}`].filter(Boolean).join(', ');
            seen.add(label.toLowerCase());
            out.push({
              label,
              line,
              city,
              state,
              zip,
              lat: Number(rLat.toFixed(6)),
              lng: Number(rLng.toFixed(6)),
              countyName: String(a.Subregion || '').trim(),
              singleLine: label
            });
          }
        }
      }
    } catch {}

    // 2. OpenStreetMap Photon reverse supplement / fallback
    try {
      const pRes = await fetch(
        'https://photon.komoot.io/reverse?' + new URLSearchParams({ lat: String(lat), lon: String(lng), limit: '5', lang: 'en' }).toString(),
        { headers: { Accept: 'application/json' } }
      );
      if (pRes.ok) {
        anyProviderOk = true;
        const pData = await pRes.json();
        for (const f of pData.features || []) {
          const p = f.properties || {};
          const [flng, flat] = f.geometry?.coordinates || [];
          if (p.countrycode && String(p.countrycode).toUpperCase() !== 'US') {
            if (!out.length) {
              return {
                suggestions: [],
                message: 'Your current location appears outside the United States. Please type a U.S. street address.'
              };
            }
            continue;
          }
          if (!p.housenumber || !(p.street || p.name)) continue;
          const state = normalizeUsState(p.state || '');
          if (!state) continue;
          const line = `${p.housenumber} ${titleCaseAddr(p.street || p.name)}`;
          const city = p.city || p.locality || p.town || p.district || '';
          const zip = p.postcode ? String(p.postcode).slice(0, 5) : '';
          const label = [line, city, `${state}${zip ? ' ' + zip : ''}`].filter(Boolean).join(', ');
          if (seen.has(label.toLowerCase())) continue;
          seen.add(label.toLowerCase());
          out.push({
            label,
            line,
            city,
            state,
            zip,
            lat: Number(flat.toFixed(6)),
            lng: Number(flng.toFixed(6)),
            countyName: String(p.county || '').trim(),
            singleLine: label
          });
        }
      }
    } catch {}

    return anyProviderOk ? { suggestions: out } : null;
  }

  function censusJsonpLookup(oneLine: string): Promise<any | null> {
    return new Promise((resolve) => {
      const cbName = `__zCensus_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
      const win = window as unknown as Record<string, any>;
      const script = document.createElement('script');
      let settled = false;
      const done = (val: any) => {
        if (settled) return;
        settled = true;
        delete win[cbName];
        script.remove();
        resolve(val);
      };
      const timer = window.setTimeout(() => done(null), 6500);
      win[cbName] = (data: any) => {
        window.clearTimeout(timer);
        done(data);
      };
      script.onerror = () => {
        window.clearTimeout(timer);
        done(null);
      };
      script.src =
        'https://geocoding.geo.census.gov/geocoder/geographies/onelineaddress?' +
        new URLSearchParams({
          address: oneLine,
          benchmark: 'Public_AR_Current',
          vintage: 'Current_Current',
          layers: 'Counties',
          format: 'jsonp',
          callback: cbName
        }).toString();
      document.head.appendChild(script);
    });
  }

  async function browserVerify(input: {
    line: string;
    city?: string;
    state?: string;
    zip?: string;
    magicKey?: string;
    singleLine?: string;
  }) {
    const line = (input.line || '').trim();
    const typedNumber = (line.match(/^(\d{1,6}[A-Za-z]?)\b/) || [])[1] || '';
    if (!typedNumber || line.length < 5 || /fake|nowhere|test street|asdf/i.test(line)) {
      return {
        status: 'not-found' as const,
        message: 'Start with your real U.S. house or building number (for example, 104 Dauphin St, Mobile, AL).'
      };
    }

    const rawState = (input.state || '').trim();
    const stNorm = normalizeUsState(rawState);
    if (rawState && !stNorm) {
      return {
        status: 'outside-area' as const,
        message: 'Please enter a valid pickup address within the United States (50 states, DC, or U.S. territories).'
      };
    }
    const stZip = [stNorm, (input.zip || '').trim()].filter(Boolean).join(' ');
    const oneLine =
      (input.singleLine || '').trim() ||
      [line, (input.city || '').trim(), stZip].filter(Boolean).join(', ');

    let anyProviderReachable = false;

    // 1. Primary Rooftop Parcel Verification: Esri ArcGIS World Geocoder (All 50 U.S. States + DC)
    try {
      const cands = await arcgisFindCandidates(oneLine, input.magicKey || '', 5);
      if (cands !== null) {
        anyProviderReachable = true;
        for (const c of cands) {
          const addr = arcgisCandidateToAddress(c, typedNumber);
          if (addr) {
            return {
              status: 'verified' as const,
              source: 'arcgis',
              address: addr
            };
          }
        }
      }
    } catch {}

    // 2. Official Federal U.S. Census Bureau Geocoder (Nationwide TIGER address ranges + counties)
    if (oneLine.includes(',') || /\b\d{5}\b/.test(oneLine)) {
      const census = await censusJsonpLookup(oneLine);
      if (census) anyProviderReachable = true;
      const match = census?.result?.addressMatches?.[0];
      if (match) {
        const c = match.addressComponents || {};
        const state = normalizeUsState(c.state || stNorm);
        if (state) {
          const num = (String(match.matchedAddress || '').match(/^(\d+[A-Z]?)/i) || [])[1] || typedNumber;
          const streetParts = [c.preQualifier, c.preDirection, c.preType, c.streetName, c.suffixType, c.suffixDirection, c.suffixQualifier]
            .filter(Boolean)
            .join(' ');
          const county = match.geographies?.Counties?.[0] || {};
          return {
            status: 'verified' as const,
            source: 'census',
            address: {
              line: titleCaseAddr(`${num} ${streetParts}`),
              city: titleCaseAddr(c.city || input.city || ''),
              state,
              zip: String(c.zip || input.zip || '').slice(0, 5),
              lat: Number(Number(match.coordinates?.y).toFixed(6)),
              lng: Number(Number(match.coordinates?.x).toFixed(6)),
              countyFips: String(county.GEOID || ''),
              countyName: String(county.NAME || '')
            }
          };
        }
      }
    }

    // 3. Nationwide OpenStreetMap Photon House-Number Fallback
    try {
      const res = await fetch(
        'https://photon.komoot.io/api/?' + new URLSearchParams({ q: oneLine, limit: '6', lang: 'en' }).toString(),
        { headers: { Accept: 'application/json' } }
      );
      if (res.ok) {
        anyProviderReachable = true;
        const data = await res.json();
        for (const f of data.features || []) {
          const p = f.properties || {};
          const [lng, lat] = f.geometry?.coordinates || [];
          if (String(p.countrycode || '').toUpperCase() !== 'US') continue;
          if (String(p.housenumber || '').toUpperCase() !== typedNumber.toUpperCase()) continue;
          const state = normalizeUsState(p.state || stNorm);
          if (!state || typeof lat !== 'number' || typeof lng !== 'number') continue;
          return {
            status: 'map-match' as const,
            source: 'openstreetmap',
            address: {
              line: `${typedNumber} ${titleCaseAddr(p.street || p.name || '')}`,
              city: titleCaseAddr(p.city || p.locality || p.town || input.city || ''),
              state,
              zip: p.postcode ? String(p.postcode).slice(0, 5) : (input.zip || '').slice(0, 5),
              lat: Number(lat.toFixed(6)),
              lng: Number(lng.toFixed(6)),
              countyFips: '',
              countyName: String(p.county || '')
            }
          };
        }
      }
    } catch {}

    // 4. Smart Disambiguation: if user typed street without city/state (e.g. "233 S Wacker"), surface U.S. city options
    if (!input.city && !input.zip && !input.magicKey) {
      const partialMatches = await browserSuggest(oneLine).catch(() => null);
      if (partialMatches && partialMatches.length === 1 && partialMatches[0].magicKey) {
        return browserVerify({
          line: partialMatches[0].line,
          city: partialMatches[0].city,
          state: partialMatches[0].state,
          zip: partialMatches[0].zip,
          magicKey: partialMatches[0].magicKey,
          singleLine: partialMatches[0].singleLine
        });
      }
      if (partialMatches && partialMatches.length > 1) {
        return {
          status: 'ambiguous' as const,
          suggestions: partialMatches,
          message: 'Multiple U.S. cities match that street — tap your exact address from the list above.'
        };
      }
    }

    if (!anyProviderReachable) {
      return { status: 'unavailable' as const };
    }

    return {
      status: 'not-found' as const,
      message: `We couldn't find that U.S. street address. Include the house number, street, and city/ZIP — or call ${PHONE}.`
    };
  }

  function browserScreen(body: Record<string, any>) {
    const fieldErrors: Record<string, string> = {};
    const flags: string[] = [];
    let score = 0;
    let d = String(body.phone || '').replace(/\D/g, '');
    if (d.length === 11 && d.startsWith('1')) d = d.slice(1);
    if (d.length !== 10) fieldErrors.phone = 'Enter a 10-digit US phone number.';
    else {
      const area = d.slice(0, 3);
      const exch = d.slice(3, 6);
      const line = d.slice(6);
      if (/^[01]/.test(area) || /^[01]/.test(exch) || /^\d11$/.test(area)) fieldErrors.phone = 'That phone number is not a valid US number.';
      else if (/^(\d)\1{9}$/.test(d) || d === '1234567890' || d === '0123456789' || d === '9876543210') {
        fieldErrors.phone = 'Please enter your real phone number so we can reach you.';
      } else if (exch === '555' && /^01\d\d$/.test(line)) {
        fieldErrors.phone = '555-01xx numbers are fictional. Please enter your real phone number.';
      }
    }
    for (const key of ['firstName', 'lastName']) {
      const v = String(body[key] || '');
      if (!v.trim()) continue;
      if (URL_TEST.test(v)) fieldErrors[key] = 'Names cannot contain links.';
      else if (!/\p{L}/u.test(v)) fieldErrors[key] = 'Please enter your real name.';
    }
    const email = String(body.email || '').trim().toLowerCase();
    if (email) {
      const domain = email.split('@')[1] || '';
      if (DISPOSABLE_DOMAINS.has(domain)) {
        fieldErrors.email = 'Please use an email you actually check (temporary inboxes are not accepted), or leave it blank.';
      }
    }
    const text = ['itemDescription', 'otherItemDescription', 'accessInstructions', 'customerNotes'].map((k) => String(body[k] || '')).join(' \n ');
    const urlCount = (text.match(URL_RE) || []).length;
    if (urlCount) {
      flags.push(`${urlCount} link(s) in message`);
      score += Math.min(2, urlCount) * 35;
    }
    let promoHits = 0;
    for (const re of PROMO_PATTERNS) if (re.test(text)) promoHits++;
    if (promoHits) {
      flags.push(`Promotional wording (${promoHits})`);
      score += Math.min(3, promoHits) * 25;
    }
    const startedAt = Number(body.formStartedAt || 0);
    if (startedAt > 0 && Date.now() - startedAt < 3500) {
      flags.push('Submitted very quickly');
      score += 35;
    }
    const blocked = score >= 70;
    return {
      blocked,
      message: blocked ? `This request looks automated or promotional, so it was not sent. If you need a pickup, please call ${PHONE}.` : undefined,
      fieldErrors,
      score,
      flags
    };
  }

  function bytesToBase64(bytes: Uint8Array): string {
    let bin = '';
    const chunk = 0x8000;
    for (let i = 0; i < bytes.length; i += chunk) {
      bin += String.fromCharCode(...bytes.subarray(i, i + chunk));
    }
    return btoa(bin);
  }
  function base64ToBytes(b64: string): Uint8Array {
    const clean = b64.replace(/-/g, '+').replace(/_/g, '/');
    const pad = clean + '='.repeat((4 - (clean.length % 4)) % 4);
    const bin = atob(pad);
    const out = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
    return out;
  }

  async function compressPhotoToJpegB64(file: File, maxDim = 920, quality = 0.74): Promise<string> {
    const bitmapUrl = URL.createObjectURL(file);
    try {
      const img = await new Promise<HTMLImageElement>((resolve, reject) => {
        const el = new Image();
        el.onload = () => resolve(el);
        el.onerror = () => reject(new Error('Image decode failed'));
        el.src = bitmapUrl;
      });
      let w = img.naturalWidth || 640;
      let h = img.naturalHeight || 480;
      if (w > maxDim || h > maxDim) {
        const ratio = Math.min(maxDim / w, maxDim / h);
        w = Math.max(1, Math.round(w * ratio));
        h = Math.max(1, Math.round(h * ratio));
      }
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      const ctx2d = canvas.getContext('2d');
      if (!ctx2d) throw new Error('Canvas unavailable');
      ctx2d.drawImage(img, 0, 0, w, h);
      const dataUrl = canvas.toDataURL('image/jpeg', quality);
      return dataUrl.split(',')[1] || '';
    } finally {
      URL.revokeObjectURL(bitmapUrl);
    }
  }

  async function fileToBase64(file: File): Promise<string> {
    const buf = await file.arrayBuffer();
    return bytesToBase64(new Uint8Array(buf));
  }

  async function encryptSealedForOwner(payloadObj: unknown, publicKeySpkiB64: string) {
    const spkiBytes = base64ToBytes(publicKeySpkiB64);
    const rsaKey = await crypto.subtle.importKey(
      'spki',
      spkiBytes.buffer as ArrayBuffer,
      { name: 'RSA-OAEP', hash: 'SHA-256' },
      false,
      ['encrypt']
    );
    const aesKey = await crypto.subtle.generateKey({ name: 'AES-GCM', length: 256 }, true, ['encrypt']);
    const iv = crypto.getRandomValues(new Uint8Array(12));
    const plainBytes = new TextEncoder().encode(JSON.stringify(payloadObj));
    const ctBuf = await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, aesKey, plainBytes);
    const rawAes = await crypto.subtle.exportKey('raw', aesKey);
    const wrappedKeyBuf = await crypto.subtle.encrypt({ name: 'RSA-OAEP' }, rsaKey, rawAes);
    return {
      v: 1,
      alg: 'RSA-OAEP-256+A256GCM',
      ek: bytesToBase64(new Uint8Array(wrappedKeyBuf)),
      iv: bytesToBase64(iv),
      ct: bytesToBase64(new Uint8Array(ctBuf))
    };
  }

  /* ----------------------------- tile map ----------------------------- */
  function drawMap(
    host: HTMLElement,
    lat: number,
    lng: number,
    layer: 'street' | 'satellite',
    zoom = 18,
    panX = 0,
    panY = 0
  ) {
    const tilesEl = host.querySelector<HTMLElement>('[data-map-tiles]');
    if (!tilesEl) return;
    const w = host.clientWidth || 320;
    const h = host.clientHeight || 230;
    const zClamped = Math.max(12, Math.min(19, Math.round(zoom)));
    const maxZ = 19;
    const tz = Math.min(zClamped, maxZ);
    const ts = 256 * 2 ** (zClamped - tz);
    const n = 2 ** tz;
    const latClamped = Math.max(-85.05112878, Math.min(85.05112878, lat));
    const latR = (latClamped * Math.PI) / 180;
    const cx = ((lng + 180) / 360) * n * ts;
    const cy = ((1 - Math.log(Math.tan(latR) + 1 / Math.cos(latR)) / Math.PI) / 2) * n * ts;
    const left = cx - w / 2 - panX;
    const top = cy - h / 2 - panY;
    let html = '';
    const tyMin = Math.max(0, Math.floor(top / ts));
    const tyMax = Math.min(n - 1, Math.floor((top + h) / ts));
    for (let tx = Math.floor(left / ts); tx <= Math.floor((left + w) / ts); tx++) {
      for (let ty = tyMin; ty <= tyMax; ty++) {
        const x = ((tx % n) + n) % n;
        const src =
          layer === 'satellite'
            ? `https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/${tz}/${ty}/${x}`
            : `https://tile.openstreetmap.org/${tz}/${x}/${ty}.png`;
        html += `<img src="${src}" alt="" draggable="false" decoding="async" referrerpolicy="strict-origin-when-cross-origin" style="left:${Math.round(tx * ts - left)}px;top:${Math.round(ty * ts - top)}px;width:${ts}px;height:${ts}px">`;
      }
    }
    tilesEl.innerHTML = html;
    const pinEl = host.querySelector<HTMLElement>('[data-map-pin]');
    if (pinEl) {
      pinEl.style.left = `${Math.round(w / 2 + panX)}px`;
      pinEl.style.top = `${Math.round(h / 2 + panY)}px`;
    }
    const recenterBtn = host.querySelector<HTMLButtonElement>('[data-map-recenter]');
    if (recenterBtn) {
      recenterBtn.hidden = Math.hypot(panX, panY) < 12;
    }
    const zIn = host.querySelector<HTMLButtonElement>('[data-map-zoom="1"]');
    const zOut = host.querySelector<HTMLButtonElement>('[data-map-zoom="-1"]');
    if (zIn) zIn.disabled = zClamped >= 19;
    if (zOut) zOut.disabled = zClamped <= 12;
    const attr = host.querySelector<HTMLElement>('[data-map-attr]');
    if (attr) attr.textContent = layer === 'satellite' ? 'Imagery © Esri, Maxar' : '© OpenStreetMap contributors';
  }

  document.querySelectorAll<HTMLFormElement>('form[data-quote-form]').forEach((form) => {
    const root = form.closest<HTMLElement>('[data-pf]')!;
    const id = form.id;
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel);
    const $$ = <T extends Element = HTMLElement>(sel: string) => Array.from(root.querySelectorAll<T>(sel));
    const named = <T extends Element = HTMLInputElement>(name: string) => form.elements.namedItem(name) as T | null;
    const val = (name: string) => {
      const el = form.elements.namedItem(name);
      if (!el) return '';
      if (el instanceof RadioNodeList) return el.value || '';
      return ((el as HTMLInputElement).value || '').trim();
    };

    const statusEl = $('[data-form-status]')!;
    const nextBtn = $<HTMLButtonElement>('[data-pf-next]')!;
    const nextLabel = $('[data-pf-next-label]')!;
    const backBtn = $<HTMLButtonElement>('[data-pf-back]')!;
    const submitBtn = $<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = $('[data-submit-label]')!;
    const confirmPanel = $('[data-confirmation-panel]')!;

    let step = 1;
    let formStartedAt = 0;
    let verified: Verified | null = null;
    let lookupOffline = false;
    let manualMode = false;
    let mapLayer: 'street' | 'satellite' = 'street';
    let mapZoom = 18;
    let mapPanX = 0;
    let mapPanY = 0;
    let savedInquiry: { leadId: string; leadNumber: string; uploadToken: string } | null = null;
    const idempotencyKey = (crypto as Crypto & { randomUUID?: () => string }).randomUUID?.() || `idem-${Date.now()}-${Math.random().toString(36).slice(2)}`;
    const queuedMedia: QueuedMedia[] = [];
    let limits = { maxPhotos: 12, maxVideos: 3, maxPhotoBytes: 15 * 1048576, maxVideoBytes: 100 * 1048576 };

    const markStarted = () => {
      if (!formStartedAt) formStartedAt = Date.now();
    };
    form.addEventListener('focusin', markStarted, { once: true });
    form.addEventListener('change', markStarted, { once: true });

    /* ---------------------------- status / errors ---------------------------- */
    const showStatus = (kind: 'info' | 'error' | 'success', html: string) => {
      statusEl.className = `form-status form-status--${kind}`;
      statusEl.innerHTML = html;
      statusEl.hidden = false;
      statusEl.focus({ preventScroll: true });
      statusEl.scrollIntoView({ block: 'center', behavior: reduceMotion ? 'auto' : 'smooth' });
    };
    const clearStatus = () => {
      statusEl.hidden = true;
      statusEl.innerHTML = '';
    };
    const setErr = (name: string, msg: string) => {
      const errEl = root.querySelector<HTMLElement>(`#${id}-${name}-err`);
      if (errEl) errEl.textContent = msg;
      const input = form.querySelector<HTMLInputElement>(`#${id}-${name}`);
      if (input) {
        if (msg) input.setAttribute('aria-invalid', 'true');
        else input.removeAttribute('aria-invalid');
      }
      return !msg;
    };

    /* ------------------------------ navigation ------------------------------ */
    const updateNextLabel = () => {
      if (step === 2) nextLabel.textContent = queuedMedia.length ? 'Continue' : 'Skip photos';
      else if (step === 3) nextLabel.textContent = verified || manualMode ? 'Continue' : 'Continue';
      else nextLabel.textContent = 'Continue';
    };

    const goTo = (n: number, focus = true) => {
      step = Math.max(1, Math.min(TOTAL, n));
      $$('[data-step-pane]').forEach((p) => {
        const on = Number(p.dataset.stepPane) === step;
        p.hidden = !on;
        if (on && !reduceMotion) {
          p.classList.remove('pf-pane--in');
          void p.offsetWidth;
          p.classList.add('pf-pane--in');
        }
      });
      $$('[data-pf-seg]').forEach((s) => {
        const sn = Number(s.dataset.pfSeg);
        s.classList.toggle('is-done', sn < step);
        if (sn === step) s.setAttribute('aria-current', 'step');
        else s.removeAttribute('aria-current');
      });
      backBtn.hidden = step === 1;
      nextBtn.hidden = step === TOTAL;
      submitBtn.hidden = step !== TOTAL;
      updateNextLabel();
      if (step === TOTAL) renderReview();
      if (step === 3 && verified) requestAnimationFrame(() => renderVerified());
      if (focus) {
        const h = root.querySelector<HTMLElement>(`#${id}-h${step}`);
        root.scrollIntoView({ block: 'start', behavior: reduceMotion ? 'auto' : 'smooth' });
        h?.focus({ preventScroll: true });
      }
      saveDraft();
    };

    /* ------------------------------ step 1 ------------------------------ */
    const syncCategories = () => {
      $$<HTMLInputElement>('input[name="category"]').forEach((c) => {
        const panel = root.querySelector<HTMLElement>(`[data-chips-for="${c.value}"]`);
        if (panel) {
          panel.hidden = !c.checked;
          if (!c.checked) panel.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = false));
        }
      });
      const other = $<HTMLInputElement>(`#${id}-cat-Other`);
      const otherInput = named<HTMLInputElement>('otherItemDescription');
      if (otherInput) otherInput.placeholder = other?.checked ? 'Describe what needs to go (required)' : 'e.g. old piano, hot tub, swing set';
      const cats = selectedCategories();
      const svc = named<HTMLInputElement>('requestedService');
      if (svc) {
        svc.value = cats.includes('Cleanout')
          ? 'Cleanout Service'
          : cats.length === 1 && cats[0] === 'Electronics'
            ? 'Electronics Pickup'
            : cats.length === 1 && cats[0] === 'Furniture'
              ? 'Furniture Removal'
              : cats.length === 1 && cats[0] === 'Appliances'
                ? 'Appliance Removal'
                : 'Junk Removal';
      }
    };
    const selectedCategories = () => $$<HTMLInputElement>('input[name="category"]:checked').map((c) => c.value);
    const selectedItems = () => $$<HTMLInputElement>('input[name="selectedItem"]:checked').map((c) => ({ category: c.dataset.category || 'Other', name: c.value }));

    $$<HTMLInputElement>('input[name="category"]').forEach((c) => c.addEventListener('change', () => {
      syncCategories();
      setErr('items', '');
    }));
    $$<HTMLInputElement>('input[name="selectedItem"]').forEach((c) => c.addEventListener('change', () => setErr('items', '')));

    const truck = $('.pf-truck');
    const truckLabel = $('[data-truck-label]');
    const syncTruck = () => {
      const sel = form.querySelector<HTMLInputElement>('input[name="estimatedQuantity"]:checked');
