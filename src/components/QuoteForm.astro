  .pf-pane[hidden] { display: none; }
  .pf-pane--in { animation: pfIn .38s cubic-bezier(.2, .8, .2, 1); }
  @keyframes pfIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .pf-pane__head { display: grid; gap: .3rem; }
  .pf-pane__head h2 { margin: 0; font-size: clamp(1.45rem, 1.2rem + 1.2vw, 2rem); line-height: 1.1; letter-spacing: -.02em; outline: none; }
  .pf-pane__head p { margin: 0; color: #566476; }
  .pf-eyebrow { font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #b84509; }
  .pf-opt { font-weight: 500; color: #566476; font-size: .85em; }

  /* tiles */
  .pf-tiles { border: 0; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; }
  @media (min-width: 620px) { .pf-tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .pf-tile { position: relative; min-width: 0; }
  .pf-tile input, .pf-chip input, .pf-load__opt input, .pf-seg input, .pf-consent input { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
  .pf-consent input { position: static; opacity: 1; width: 22px; height: 22px; pointer-events: auto; accent-color: var(--pf-teal); flex: none; margin-top: .1rem; }
  .pf-tile label {
    position: relative; display: grid; gap: .2rem; align-content: start; height: 100%; min-height: 118px; padding: .9rem .85rem;
    border: 1.5px solid var(--pf-line); border-radius: var(--pf-radius); background: #fbf8f2; cursor: pointer;
    transition: transform .18s, border-color .18s, background-color .18s, box-shadow .18s; -webkit-tap-highlight-color: transparent;
  }
  .pf-tile label:active { transform: scale(.97); }
  .pf-tile__icon { width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; background: #fff; border: 1px solid var(--pf-line); color: var(--pf-ink); margin-bottom: .35rem; transition: background-color .18s, color .18s; }
  .pf-tile__icon svg { width: 26px; height: 26px; }
  .pf-tile__label { font-weight: 800; font-size: 1rem; line-height: 1.15; }
