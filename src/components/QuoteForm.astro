    const fillAddressFields = (v: { line: string; city: string; state?: string; zip: string }) => {
      const street = named<HTMLInputElement>('pickupAddress');
      const city = named<HTMLInputElement>('city');
      const stateInp = named<HTMLInputElement>('state');
      const zip = named<HTMLInputElement>('zipCode');
      if (street) street.value = v.line;
      if (city) city.value = v.city;
      if (stateInp && v.state) stateInp.value = normalizeUsState(v.state) || v.state.toUpperCase();
      if (zip) zip.value = v.zip;
    };

    const renderVerified = () => {
      if (!verified) return;
      const stCode = normalizeUsState(verified.state) || verified.state || 'AL';
      const stName = stateFullName(stCode);
      const fullText = `${verified.line}, ${verified.city}, ${stCode}${verified.zip ? ' ' + verified.zip : ''}`;
      const t = $('[data-verified-text]');
      if (t) t.textContent = fullText;
      const cty = $('[data-verified-county]');
      if (cty) {
        const cn = String(verified.countyName || '').trim();
        cty.textContent = cn && cn.toLowerCase() !== stName.toLowerCase() ? `${cn}, ${stName}` : stName;
      }
      const badge = $('[data-verified-badge]');
      if (badge) {
        badge.textContent =
          verified.status === 'verified'
            ? 'Verified U.S. address'
            : verified.status === 'map-match'
              ? 'Address pinned on map'
              : 'Address saved';
      }
      const gmaps = $<HTMLAnchorElement>('[data-verified-gmaps]');
      if (gmaps) {
        const q = verified.lat != null && verified.lng != null ? `${verified.lat},${verified.lng}` : fullText;
        gmaps.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
      }
      if (verified.lat != null && verified.lng != null) {
        mapHost.hidden = false;
        drawMap(mapHost, verified.lat, verified.lng, mapLayer, mapZoom, mapPanX, mapPanY);
      } else {
        mapHost.hidden = true;
      }
    };

    const showVerified = (v: Verified) => {
      verified = {
        ...v,
        state: normalizeUsState(v.state) || (v.state || 'AL').toUpperCase()
      };
      mapPanX = 0;
      mapPanY = 0;
      mapZoom = 18;
      fillAddressFields(verified);
      searchWrap.hidden = true;
      manualWrap.hidden = true;
      card.hidden = false;
      card.classList.remove('is-drop');
      void card.offsetWidth;
      card.classList.add('is-drop');
      setErr('pickupAddress', '');
      renderVerified();
      window.requestAnimationFrame(() => !card.hidden && renderVerified());
      updateNextLabel();
      saveDraft();
    };

    const resetAddress = () => {
      verified = null;
      mapPanX = 0;
      mapPanY = 0;
      card.hidden = true;
      searchWrap.hidden = false;
      if (manualMode) manualWrap.hidden = false;
      addrInput.value = '';
      addrInput.focus();
      saveDraft();
    };

    const cloudRelayAllowed =
      form.dataset.cloudRelay === '1' || /^(?:(?:www\.)?zoirisjunkremoval\.com|.*\.github\.io)$/i.test(window.location.hostname);
    const cloudBridgeUrl = (form.dataset.cloudBridge ?? 'https://zoiris-cloud-bridge.vercel.app').replace(/\/+$/, '');
    const relayUrl = (form.dataset.relayUrl || 'https://ntfy.sh').replace(/\/+$/, '');
    const relayTopic = form.dataset.relayTopic || '';
    const relayPubKey = form.dataset.relayPubkey || '';
    const relayClick = form.dataset.relayClick || `${window.location.origin}/owner/command-center/?sync=1`;
    let useBrowserGeo = staticCloudOnly;

    const verifyEndpoint = form.dataset.verifyEndpoint || '';
    const verifyAddress = async (input: {
      line: string;
      city?: string;
      state?: string;
      zip?: string;
      magicKey?: string;
      singleLine?: string;
    }): Promise<'ok' | 'bad' | 'offline'> => {
      if (!verifyEndpoint && !cloudRelayAllowed) return 'offline';
      busy(true);
      setErr('pickupAddress', '');
      try {
        let data: any = null;
        if (verifyEndpoint && !useBrowserGeo) {
          const res = await postJson(verifyEndpoint, {
            line: input.line,
            city: input.city || '',
            state: input.state || '',
            zip: input.zip || '',
            magicKey: input.magicKey || '',
            singleLine: input.singleLine || ''
          }).catch(() => ({ data: null }));
          data = res.data;
        }
        if (!data && cloudRelayAllowed) {
          useBrowserGeo = true;
          data = await browserVerify(input);
        }
        if (!data) {
          lookupOffline = true;
          return 'offline';
        }
        if ((data.status === 'verified' || data.status === 'map-match') && data.address) {
          showVerified({
            ...data.address,
            token: data.token || 'browser-verified',
            status: data.status,
            source: data.source || '',
            countyFips: data.address.countyFips || '',
            countyName: data.address.countyName || ''
          });
          return 'ok';
        }
        if (data.status === 'ambiguous' && Array.isArray(data.suggestions) && data.suggestions.length) {
          renderList(data.suggestions);
          setErr('pickupAddress', data.message || 'Tap your exact U.S. city and state from the list above.');
          return 'bad';
        }
        if (data.status === 'unavailable') return 'offline';
        setErr('pickupAddress', data.message || data.error || "We couldn't find that U.S. street address.");
        return 'bad';
      } catch {
        lookupOffline = true;
        return 'offline';
      } finally {
        busy(false);
      }
    };

    const choose = async (s: Suggestion) => {
      closeList();
      addrInput.value = s.label;
      if (s.lat != null && s.lng != null && !s.magicKey) {
        showVerified({
          line: s.line,
          city: s.city,
          state: s.state,
          zip: s.zip,
          lat: s.lat,
          lng: s.lng,
          countyName: s.countyName || '',
          countyFips: '',
          source: 'arcgis',
          token: 'browser-verified',
          status: 'verified'
        });
        return;
      }
      const r = await verifyAddress({
        line: s.line,
        city: s.city,
        state: s.state,
        zip: s.zip,
        magicKey: s.magicKey,
        singleLine: s.singleLine || s.label
      });
      if (r === 'offline') {
        fillAddressFields(s);
        enterManual('We could not double-check this address right now. Confirm it below and we will verify it with you.');
      }
    };

    const suggestEndpoint = form.dataset.suggestEndpoint || '';
    addrInput.addEventListener('input', () => {
      setErr('pickupAddress', '');
      window.clearTimeout(suggestTimer);
      const q = addrInput.value.trim();
      if (q.length < 3 || lookupOffline || (!suggestEndpoint && !cloudRelayAllowed)) return closeList();
      suggestTimer = window.setTimeout(async () => {
        const seq = ++suggestSeq;
        busy(true);
        try {
          let items: Suggestion[] | null = null;
          if (suggestEndpoint && !useBrowserGeo) {
            const { data } = await postJson(suggestEndpoint, { q }).catch(() => ({ data: null }));
            if (seq !== suggestSeq) return;
            if (data) items = data.suggestions || [];
          }
          if (items === null && cloudRelayAllowed) {
            useBrowserGeo = true;
            items = await browserSuggest(q).catch(() => null);
            if (seq !== suggestSeq) return;
          }
          if (items === null) {
            lookupOffline = true;
            closeList();
            enterManual('Address search is unavailable right now — please type your address below.');
            return;
          }
          renderList(
            items,
            /^\d/.test(q)
              ? 'Keep typing street and city/ZIP, or tap "Check this address".'
              : 'Start with your house or building number (e.g. 1100 Congress Ave)'
          );
        } catch {
          lookupOffline = true;
          closeList();
          enterManual('Address search is unavailable right now — please type your address below.');
        } finally {
          if (seq === suggestSeq) busy(false);
        }
      }, 180);
    });

    addrInput.addEventListener('keydown', (e) => {
      const opts = Array.from(addrList.querySelectorAll<HTMLElement>('[data-opt]'));
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        if (!opts.length) return;
        e.preventDefault();
        activeIdx = (activeIdx + (e.key === 'ArrowDown' ? 1 : -1) + opts.length) % opts.length;
        opts.forEach((o, i) => o.setAttribute('aria-selected', String(i === activeIdx)));
        addrInput.setAttribute('aria-activedescendant', opts[activeIdx].id);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIdx >= 0 && suggestions[activeIdx]) choose(suggestions[activeIdx]);
        else if (suggestions.length === 1 && !addrList.hidden) choose(suggestions[0]);
        else if (addrInput.value.trim()) $<HTMLButtonElement>('[data-address-check]')?.click();
      } else if (e.key === 'Escape') {
        closeList();
      }
    });
    addrList.addEventListener('mousedown', (e) => e.preventDefault());
    addrList.addEventListener('click', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('[data-opt]');
      if (li) choose(suggestions[Number(li.dataset.opt)]);
    });
    // Close suggestions only when tapping outside the address search block (never on mobile soft-keyboard dismiss!)
    document.addEventListener('pointerdown', (e) => {
      if (!addrList.hidden && !searchWrap.contains(e.target as Node)) {
        closeList();
      }
    });

    $('[data-address-check]')?.addEventListener('click', async () => {
      const text = addrInput.value.trim();
      if (!text) {
        setErr('pickupAddress', 'Type your U.S. street address first.');
        addrInput.focus();
        return;
      }
      if (suggestions.length === 1 && !addrList.hidden) {
        await choose(suggestions[0]);
        return;
      }
      closeList();
      const r = await verifyAddress({ line: text, singleLine: text });
      if (r === 'offline') enterManual('We could not double-check addresses right now. Type it below and we will confirm it with you.');
    });

    $('[data-address-locate]')?.addEventListener('click', () => {
      const reverseUrl = form.dataset.reverseEndpoint || '';
      if (!('geolocation' in navigator) || (!reverseUrl && !cloudRelayAllowed)) {
        setErr('pickupAddress', 'Location is not available on this device — please type your address.');
        return;
      }
      busy(true);
      navigator.geolocation.getCurrentPosition(
        async (pos) => {
          try {
            let data: any = null;
            if (reverseUrl && !useBrowserGeo) {
              const res = await postJson(reverseUrl, { lat: pos.coords.latitude, lng: pos.coords.longitude }).catch(() => ({ data: null }));
              data = res.data;
            }
            if (!data && cloudRelayAllowed) {
              useBrowserGeo = true;
              data = await browserReverse(pos.coords.latitude, pos.coords.longitude);
            }
            if (!data) {
              enterManual('Address lookup is unavailable right now — please type your address below.');
              return;
            }
            if (data.message) setErr('pickupAddress', data.message);
            const items: Suggestion[] = data.suggestions || [];
            if (items.length === 1) {
              await choose(items[0]);
            } else if (items.length > 1) {
              addrInput.focus();
              renderList(items);
            } else if (!data.message) setErr('pickupAddress', "We couldn't pin down your exact address — please type it.");
          } catch {
            setErr('pickupAddress', 'Location lookup failed — please type your address.');
          } finally {
            busy(false);
          }
        },
        () => {
          busy(false);
          setErr('pickupAddress', 'Location permission was declined — no problem, just type your address.');
        },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 }
      );
    });

    $('[data-address-change]')?.addEventListener('click', resetAddress);
    $$<HTMLButtonElement>('[data-map-layer]').forEach((b) =>
      b.addEventListener('click', () => {
        mapLayer = b.dataset.mapLayer === 'satellite' ? 'satellite' : 'street';
        $$<HTMLButtonElement>('[data-map-layer]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        renderVerified();
      })
    );
    $$<HTMLButtonElement>('[data-map-zoom]').forEach((b) =>
      b.addEventListener('click', () => {
        const dz = Number(b.dataset.mapZoom || 0);
        const nextZ = Math.max(12, Math.min(19, mapZoom + dz));
        if (nextZ === mapZoom) return;
        const scale = 2 ** (nextZ - mapZoom);
        mapPanX *= scale;
        mapPanY *= scale;
        mapZoom = nextZ;
        renderVerified();
      })
    );
    $('[data-map-recenter]')?.addEventListener('click', () => {
      mapPanX = 0;
      mapPanY = 0;
      renderVerified();
    });

    // Interactive touch/mouse drag panning on the verified map preview
    (() => {
      let dragId: number | null = null;
      let startX = 0;
      let startY = 0;
      mapHost.addEventListener('pointerdown', (e) => {
        if ((e.target as HTMLElement).closest('button')) return;
        dragId = e.pointerId;
        startX = e.clientX;
        startY = e.clientY;
        try {
          mapHost.setPointerCapture(e.pointerId);
        } catch {}
      });
      mapHost.addEventListener('pointermove', (e) => {
        if (dragId !== e.pointerId || !verified) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        startX = e.clientX;
        startY = e.clientY;
        mapPanX += dx;
        mapPanY += dy;
        renderVerified();
      });
      const endDrag = (e: PointerEvent) => {
        if (dragId === e.pointerId) dragId = null;
      };
      mapHost.addEventListener('pointerup', endDrag);
      mapHost.addEventListener('pointercancel', endDrag);
    })();

    if ('ResizeObserver' in window) {
      let lastMapSize = '';
      const mapRo = new ResizeObserver(() => {
        if (card.hidden || !verified) return;
        const sig = `${mapHost.clientWidth}x${mapHost.clientHeight}`;
        if (sig !== lastMapSize && mapHost.clientWidth > 0) {
          lastMapSize = sig;
          renderVerified();
        }
      });
      mapRo.observe(mapHost);
    }
    window.addEventListener('resize', () => !card.hidden && renderVerified());

    // Access + timing reveals
    const syncReveals = () => {
      const where = val('indoorsOrOutdoors');
      const stairs = $('[data-stairs-wrap]');
      if (stairs) stairs.hidden = where !== 'Inside – upstairs';
      const date = $('[data-date-wrap]');
      if (date) date.hidden = val('timing') !== 'Pick a date';
    };
    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'indoorsOrOutdoors' || t.name === 'timing') syncReveals();
      if (t.name === 'indoorsOrOutdoors') {
        setErr('indoorsOrOutdoors', '');
        if (!verified && !manualMode && !lookupOffline && addrInput.value.trim().length >= 5) {
          closeList();
          verifyAddress({ line: addrInput.value.trim(), singleLine: addrInput.value.trim() });
        }
      }
      saveDraft();
    });

    /* ------------------------------ step 4 ------------------------------ */
    const phoneInput = named<HTMLInputElement>('phone');
    phoneInput?.addEventListener('input', () => {
      const d = phoneInput.value.replace(/\D/g, '').replace(/^1(?=\d{10})/, '').slice(0, 10);
      if (d.length >= 7) phoneInput.value = `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6)}`;
      else if (d.length >= 4) phoneInput.value = `(${d.slice(0, 3)}) ${d.slice(3)}`;
      setErr('phone', '');
    });
    ['firstName', 'lastName', 'email'].forEach((n) => named<HTMLInputElement>(n)?.addEventListener('input', () => setErr(n, '')));
    named<HTMLInputElement>('consentGiven')?.addEventListener('change', () => setErr('consentGiven', ''));

    const addressText = () => {
      const line = val('pickupAddress');
      const unit = val('addressUnit');
      const st = normalizeUsState(verified?.state || val('state')) || (val('state') || 'AL').toUpperCase();
      return line ? `${line}${unit ? ` ${unit}` : ''}, ${val('city')}, ${st} ${val('zipCode')}`.replace(/\s+/g, ' ').trim() : '';
    };

    const renderReview = () => {
      const items = selectedItems().map((i) => i.name.replace(/ \((confirmation required|subject to acceptance)\)/, ''));
      const other = val('otherItemDescription');
      const photos = queuedMedia.filter((m) => m.kind === 'photo').length;
      const videos = queuedMedia.filter((m) => m.kind === 'video').length;
      const cats = selectedCategories().filter((c) => c !== 'Other');
      const timing = val('timing') === 'Pick a date' && val('preferredDate') ? val('preferredDate') : val('timing');
      const row = (label: string, value: string, goto: number) =>
        `<div class="pf-ticket__row"><dt>${label}</dt><dd>${value}</dd><button type="button" class="pf-link" data-goto="${goto}" aria-label="Edit ${label}">Edit</button></div>`;
      $('[data-review-summary]')!.innerHTML = `
        <div class="pf-ticket__head"><span>Pickup request</span><span class="pf-ticket__stamp">Draft</span></div>
        <dl>
          ${row('Name', esc(`${val('firstName')} ${val('lastName')}`.trim() || '—'), 4)}
          ${row('Items', esc([items.length ? items.join(', ') : cats.join(', '), other].filter(Boolean).join(' · ') || '—'), 1)}
          ${row('Amount', esc(val('estimatedQuantity') || '—'), 1)}
          ${row('Photos', `${photos} photo(s), ${videos} video(s) attached`, 2)}
          ${row('Address', `${esc(addressText() || '—')}${verified ? ' <span class="pf-ok">✓ verified</span>' : ''}`, 3)}
          ${row('Where', esc([val('indoorsOrOutdoors'), val('hasStairs')].filter(Boolean).join(' · ') || '—'), 3)}
          ${row('When', esc(`${timing || 'Flexible'} · ${val('preferredWindow') || 'Flexible'}`), 3)}
        </dl>`;
    };
    root.addEventListener('click', (e) => {
      const g = (e.target as HTMLElement).closest<HTMLElement>('[data-goto]');
      if (g) goTo(Number(g.dataset.goto));
    });

    /* ------------------------------ validation ------------------------------ */
    const validateStep = (n: number): boolean => {
      if (n === 1) {
        const items = selectedItems();
        const cats = selectedCategories();
        const other = val('otherItemDescription');
        let ok = true;
        if (cats.includes('Other') && other.length < 3) {
          ok = setErr('items', 'Tell us what the "something else" is.') && ok;
          named<HTMLInputElement>('otherItemDescription')?.focus();
        } else if (!items.length && other.length < 3 && !cats.some((c) => c !== 'Other')) {
          ok = setErr('items', 'Tap at least one type of item, or describe what needs to go.') && ok;
        } else setErr('items', '');
        if (!val('estimatedQuantity')) ok = setErr('estimatedQuantity', 'Choose about how much there is — "Not sure" is fine.') && ok;
        return ok;
      }
      if (n === 3) {
        let ok = true;
        if (!verified) {
          if (manualMode) {
            if (val('pickupAddress').length < 4 || !/^\d/.test(val('pickupAddress'))) ok = setErr('pickupAddress', 'Enter the street address with the house number.') && ok;
            if (val('city').length < 2) ok = setErr('city', 'Enter the city.') && ok;
            if (!normalizeUsState(val('state'))) ok = setErr('state', 'Enter a 2-letter U.S. state (e.g. AL, TX, CA).') && ok;
            if (!/^\d{5}$/.test(val('zipCode'))) ok = setErr('zipCode', 'Enter the 5-digit ZIP code.') && ok;
          } else {
            ok = setErr('pickupAddress', 'Choose your U.S. address from the list (or tap "Check this address").') && ok;
            addrInput.focus();
          }
        }
        if (!val('indoorsOrOutdoors')) ok = setErr('indoorsOrOutdoors', 'Tell us where the items are.') && ok;
        return ok;
      }
      if (n === 4) {
        let ok = true;
        if (!val('firstName')) ok = setErr('firstName', 'Please enter your first name.') && ok;
        if (!val('lastName')) ok = setErr('lastName', 'Please enter your last name.') && ok;
        const digits = val('phone').replace(/\D/g, '').replace(/^1(?=\d{10})/, '');
        if (digits.length !== 10 || /^[01]/.test(digits) || /^[01]/.test(digits.slice(3))) ok = setErr('phone', 'Enter a 10-digit US phone number we can reach you at.') && ok;
        const email = val('email');
        if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) ok = setErr('email', 'That email looks incomplete — fix it or leave it blank.') && ok;
        if (!ok) form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return ok;
      }
      return true;
    };

    nextBtn.addEventListener('click', async () => {
      clearStatus();
      if (step === 3 && !verified && !manualMode && !lookupOffline && addrInput.value.trim().length >= 5) {
        nextBtn.disabled = true;
        closeList();
        const r = await verifyAddress({ line: addrInput.value.trim(), singleLine: addrInput.value.trim() });
        nextBtn.disabled = false;
        if (r === 'bad') return;
        if (r === 'offline') enterManual('Confirm your U.S. street address below.');
      }
      if (!validateStep(step)) return;
      if (step === 3 && !verified && manualMode && !lookupOffline) {
        nextBtn.disabled = true;
        const r = await verifyAddress({ line: val('pickupAddress'), city: val('city'), state: val('state'), zip: val('zipCode') });
        nextBtn.disabled = false;
        if (r === 'bad') return;
      }
      goTo(step + 1);
    });
    backBtn.addEventListener('click', () => {
      clearStatus();
      goTo(step - 1);
    });
    $$<HTMLElement>('[data-pf-seg]').forEach((s) =>
      s.addEventListener('click', () => {
        const target = Number(s.dataset.pfSeg);
        if (target < step) goTo(target);
      })
    );

    /* ------------------------------ draft autosave ------------------------------ */
    function saveDraft() {
      try {
        const data: Record<string, string | string[]> = {};
        for (const el of Array.from(form.elements) as HTMLInputElement[]) {
          if (!el.name || el.type === 'file' || el.name === '_gotcha' || el.name === 'consentGiven') continue;
          if (el.type === 'checkbox') {
            if (el.checked) data[el.name] = [...((data[el.name] as string[]) || []), el.value];
          } else if (el.type === 'radio') {
            if (el.checked) data[el.name] = el.value;
          } else if (el.value) data[el.name] = el.value;
        }
        localStorage.setItem(DRAFT_KEY, JSON.stringify({ at: Date.now(), step, data, verified, manualMode }));
      } catch {}
    }
    const restoreDraft = () => {
      try {
        const raw = localStorage.getItem(DRAFT_KEY);
        if (!raw) return;
        const d = JSON.parse(raw);
        if (!d || Date.now() - d.at > 3 * 86400000) return localStorage.removeItem(DRAFT_KEY);
        let restoredAny = false;
        for (const el of Array.from(form.elements) as HTMLInputElement[]) {
          const v = d.data?.[el.name];
          if (v == null || el.type === 'file' || el.type === 'hidden') continue;
          if (el.type === 'checkbox') el.checked = Array.isArray(v) && v.includes(el.value);
          else if (el.type === 'radio') el.checked = el.value === v;
          else el.value = String(v);
          restoredAny = true;
        }
        manualMode = !!d.manualMode;
        if (manualMode) manualWrap.hidden = false;
        syncCategories();
        syncTruck();
        syncReveals();
        if (d.verified?.token) showVerified(d.verified);
        if (restoredAny) {
          const note = $('[data-pf-restored]');
          if (note) note.hidden = false;
          goTo(Math.min(Number(d.step) || 1, 3), false);
        }
      } catch {}
    };
    $('[data-pf-reset]')?.addEventListener('click', () => {
      try {
        localStorage.removeItem(DRAFT_KEY);
      } catch {}
      window.location.reload();
    });
    form.addEventListener('input', () => {
      if (step === TOTAL) renderReview();
      saveDraft();
    });

    /* ------------------------------ submit + uploads ------------------------------ */
    const uploadOne = (item: QueuedMedia, token: string): Promise<boolean> =>
      new Promise((resolve) => {
        item.state = 'uploading';
        item.progress = 4;
        item.error = undefined;
        renderMedia();
        const fd = new FormData();
        fd.append('uploadToken', token);
        fd.append('file', item.file, item.file.name);
        const xhr = new XMLHttpRequest();
        xhr.open('POST', form.dataset.uploadEndpoint || '/api/public/uploads', true);
        xhr.setRequestHeader('X-Upload-Token', token);
        xhr.upload.onprogress = (ev) => {
          if (!ev.lengthComputable) return;
          item.progress = Math.max(4, Math.min(98, Math.round((ev.loaded / ev.total) * 100)));
          const bar = mediaGrid.querySelector<HTMLElement>(`[data-bar="${item.uid}"]`);
          if (bar) bar.style.width = `${item.progress}%`;
        };
        xhr.onload = () => {
          let parsed: { ok?: boolean; error?: string } = {};
          try {
            parsed = JSON.parse(xhr.responseText || '{}');
          } catch {}
          if (xhr.status >= 200 && xhr.status < 300 && parsed.ok !== false) {
            item.state = 'uploaded';
            item.progress = 100;
            const emit = (window as unknown as { zoirisEmitEvent?: (t: string) => void }).zoirisEmitEvent;
            if (typeof emit === 'function') emit('upload_complete');
            renderMedia();
            resolve(true);
          } else {
            item.state = 'failed';
            item.error = parsed.error || `Upload failed (HTTP ${xhr.status}).`;
            renderMedia();
            mediaErr.textContent = item.error;
            resolve(false);
          }
        };
        xhr.onerror = () => {
          item.state = 'failed';
          item.error = 'Connection interrupted during upload.';
          renderMedia();
          resolve(false);
        };
        xhr.send(fd);
      });

    async function finalize() {
      if (!savedInquiry) return;
      if (queuedMedia.length && savedInquiry.uploadToken && savedInquiry.uploadToken !== 'cloud-relay') {
        try {
          await fetch(form.dataset.uploadCompleteEndpoint || '/api/public/uploads/complete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ uploadToken: savedInquiry.uploadToken })
          });
        } catch {}
      }
      window.dispatchEvent(new CustomEvent('zoiris:lead', { detail: { provider: form.dataset.provider || 'zoiris-crm', leadNumber: savedInquiry.leadNumber } }));
      try {
        localStorage.removeItem(DRAFT_KEY);
      } catch {}
      const uploaded = queuedMedia.filter((m) => m.state === 'uploaded').length;
      const first = val('firstName');
      form.hidden = true;
      $('[data-pf-top]')!.hidden = true;
      const restored = $('[data-pf-restored]');
      if (restored) restored.hidden = true;
      confirmPanel.innerHTML = `
        <div class="pf-done__check" aria-hidden="true"><svg viewBox="0 0 52 52"><circle cx="26" cy="26" r="23"/><path d="m15 27 7.5 7.5L38 19"/></svg></div>
        <h2>Got it${first ? `, ${esc(first)}` : ''}!</h2>
        <p class="pf-done__lead">Your pickup request is in. Keep this reference number:</p>
        <p class="pf-done__ref"><span data-lead-reference>${esc(savedInquiry.leadNumber)}</span></p>
        ${uploaded ? `<p class="pf-done__media"><strong>${uploaded} media file(s)</strong> were securely attached to your request.</p>` : ''}
        <ol class="pf-done__steps">
          <li><span><strong>We review</strong> your items${uploaded ? ' and photos' : ''}.</span></li>
          <li><span><strong>We call or text you</strong> with an estimate and open time windows.</span></li>
          <li><span><strong>You pick a time</strong> — then we confirm the pickup.</span></li>
        </ol>
        <p class="pf-done__note">Your pickup is not booked until we confirm it with you directly.</p>
        <a class="pf-btn pf-btn--go pf-done__call" href="tel:+12519308621" data-track="call" data-track-location="pickup-confirmation">Need us sooner? <span class="pf-nowrap">Call ${PHONE}</span></a>`;
      confirmPanel.hidden = false;
      confirmPanel.focus();
      root.scrollIntoView({ block: 'start', behavior: reduceMotion ? 'auto' : 'smooth' });
    }

    const stepForField: Record<string, number> = { items: 1, estimatedQuantity: 1, pickupAddress: 3, city: 3, state: 3, zipCode: 3, indoorsOrOutdoors: 3, firstName: 4, lastName: 4, phone: 4, email: 4, consentGiven: 4 };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (step !== TOTAL) return;
      for (const n of [1, 3, 4]) {
        if (!validateStep(n)) {
          if (n !== step) goTo(n);
          return;
        }
      }
      const consent = named<HTMLInputElement>('consentGiven');
      if (!consent?.checked) {
        setErr('consentGiven', 'Please check the box so we have permission to contact you about this request.');
        consent?.focus();
        return;
      }
      if (named<HTMLInputElement>('_gotcha')?.value) return;

      const endpoint = form.dataset.endpoint || '';
      if (!endpoint || form.dataset.provider === 'none') {
        showStatus('info', `Online requests are not connected yet, so this request was <strong>not sent</strong>. Please call <a href="tel:+12519308621">${PHONE}</a>.`);
        return;
      }

      submitBtn.disabled = true;
      submitLabel.textContent = queuedMedia.length ? 'Sending & uploading…' : 'Sending…';
      clearStatus();
      try {
        if (!savedInquiry) {
          let utm = { source: '', medium: '', campaign: '' };
          try {
            const raw = sessionStorage.getItem('zoiris_utm');
            if (raw) utm = JSON.parse(raw);
          } catch {}
          const where = val('indoorsOrOutdoors');
          const timing = val('timing');
          const payload = {
            idempotencyKey,
            firstName: val('firstName'),
            lastName: val('lastName'),
            name: `${val('firstName')} ${val('lastName')}`.trim(),
            phone: val('phone'),
            email: val('email'),
            preferredContact: val('preferredContact') || 'phone',
            customerType: val('customerType') || 'residential',
            pickupAddress: val('pickupAddress'),
            addressUnit: val('addressUnit'),
            city: val('city'),
            state: normalizeUsState(verified?.state || val('state')) || (val('state') || 'AL').toUpperCase(),
            zipCode: val('zipCode'),
            addressToken: verified?.token || '',
            requestedService: val('requestedService') || 'Junk Removal',
            selectedItems: selectedItems().length
              ? selectedItems()
              : selectedCategories()
                  .filter((c) => c !== 'Other')
                  .map((c) => ({ category: c === 'Cleanout' || c === 'Household' ? 'Other' : c, name: `${c} (type not specified)` })),
            otherItemDescription: val('otherItemDescription'),
            estimatedQuantity: val('estimatedQuantity'),
            itemDescription: val('itemDescription'),
            indoorsOrOutdoors: where,
            floorLevel: where === 'Inside – upstairs' ? '2nd floor or higher' : where.startsWith('Inside') ? 'Ground floor' : '',
            hasStairs: val('hasStairs') === 'Stairs only' ? 'Stairs' : val('hasStairs') ? 'No stairs needed' : '',
            elevatorAvailable: val('hasStairs') === 'Elevator available' ? 'Elevator available' : val('hasStairs') === 'Stairs only' ? 'No elevator available' : '',
            accessInstructions: val('accessInstructions'),
            customerNotes: val('accessInstructions'),
            preferredDate: timing === 'Pick a date' ? val('preferredDate') : '',
            preferredWindow: `${timing === 'Pick a date' ? '' : `${timing} · `}${val('preferredWindow') || 'Flexible'}`,
            consentGiven: true,
            expectedFiles: queuedMedia.length,
            formStartedAt: formStartedAt || Date.now(),
            source: 'zoiris-website',
            sourceType: 'website_form',
            sourceUrl: window.location.href,
            sourcePagePath: window.location.pathname,
            referrerUrl: document.referrer || '',
            utmSource: utm.source || '',
            utmMedium: utm.medium || '',
            utmCampaign: utm.campaign || '',
            deviceCategory: window.innerWidth < 768 ? 'mobile' : window.innerWidth < 1024 ? 'tablet' : 'desktop'
          };
          let res: Response | null = null;
          let ct = '';
          if (!staticCloudOnly) {
            try {
              res = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Idempotency-Key': idempotencyKey },
                body: JSON.stringify(payload)
              });
              ct = res.headers.get('content-type') || '';
            } catch (netErr) {
              if (!cloudRelayAllowed || (!cloudBridgeUrl && (!relayTopic || !relayPubKey))) throw netErr;
            }
          }

          const staticNoApi = !res || ((res.status === 404 || res.status === 405) && !ct.includes('application/json'));
          if (staticNoApi) {
            if (!cloudRelayAllowed || (!cloudBridgeUrl && (!relayTopic || !relayPubKey))) {
              showStatus('info', `Online requests are offline on this preview, so your request was <strong>not saved</strong>. Please call <a href="tel:+12519308621">${PHONE}</a> and we will take it by phone.`);
              return;
            }

            // 1. Run full anti-spam / anti-scam validation in browser
            const screen = browserScreen(payload);
            if (screen.blocked) {
              showStatus('error', esc(screen.message || 'Request blocked by spam filter.'));
              return;
            }
            if (Object.keys(screen.fieldErrors).length) {
              let firstStep = TOTAL;
              for (const [k, msg] of Object.entries(screen.fieldErrors)) {
                setErr(k, msg);
                firstStep = Math.min(firstStep, stepForField[k] || TOTAL);
              }
              if (firstStep !== step) goTo(firstStep);
              showStatus('error', 'Please fix the highlighted fields and try again.');
              return;
            }

            // 2. Ensure address is verified when online
            if (!verified) {
              const vCheck = await browserVerify({ line: payload.pickupAddress, city: payload.city, state: payload.state, zip: payload.zipCode });
              if (vCheck.status === 'verified' || vCheck.status === 'map-match') {
                showVerified({
                  ...vCheck.address,
                  token: 'browser-verified',
                  status: vCheck.status,
                  source: vCheck.source || '',
                  countyFips: vCheck.address.countyFips || '',
                  countyName: vCheck.address.countyName || ''
                });
                payload.pickupAddress = vCheck.address.line;
                payload.city = vCheck.address.city;
                payload.state = vCheck.address.state;
                payload.zipCode = vCheck.address.zip;
              } else if (vCheck.status === 'outside-area' || vCheck.status === 'not-found' || vCheck.status === 'ambiguous') {
                setErr('pickupAddress', vCheck.message);
                goTo(3);
                showStatus('error', esc(vCheck.message));
                return;
              }
            }

            // 3. Compress photos & prepare encrypted payload (capped cleanly under 3.2 MB base64 budget)
            const relayMedia: Array<{ filename: string; mime: string; kind: 'photo' | 'video'; dataB64: string }> = [];
            let photoCapCount = 0;
            let totalMediaB64Len = 0;
            const MAX_TOTAL_B64 = 3200 * 1024;
            for (const item of queuedMedia) {
              item.state = 'uploading';
              item.progress = 35;
              renderMedia();
              try {
                if (item.kind === 'photo' && photoCapCount < 6) {
                  let dataB64 = await compressPhotoToJpegB64(item.file, 920, 0.74);
                  if (totalMediaB64Len + dataB64.length > MAX_TOTAL_B64) {
                    dataB64 = await compressPhotoToJpegB64(item.file, 720, 0.66);
                  }
                  if (totalMediaB64Len + dataB64.length <= MAX_TOTAL_B64) {
                    relayMedia.push({
                      filename: item.file.name.replace(/\.[^.]+$/, '') + '.jpg',
                      mime: 'image/jpeg',
                      kind: 'photo',
                      dataB64
                    });
                    totalMediaB64Len += dataB64.length;
                    photoCapCount++;
                  }
                } else if (item.kind === 'video' && item.file.size <= 1200 * 1024 && totalMediaB64Len + item.file.size * 1.38 <= MAX_TOTAL_B64) {
                  const dataB64 = await fileToBase64(item.file);
                  relayMedia.push({
                    filename: item.file.name,
                    mime: item.file.type || 'video/mp4',
                    kind: 'video',
                    dataB64
                  });
                  totalMediaB64Len += dataB64.length;
                } else {
                  payload.customerNotes = [
                    payload.customerNotes,
                    `[Customer also selected ${item.kind} "${item.file.name}" (${fmtBytes(item.file.size)}) — ask customer to text if needed]`
                  ]
                    .filter(Boolean)
                    .join('\n');
                }
                item.state = 'uploaded';
                item.progress = 100;
                renderMedia();
              } catch {
                item.state = 'uploaded';
                item.progress = 100;
                renderMedia();
              }
            }

            const randBuf = new Uint32Array(1);
            crypto.getRandomValues(randBuf);
            const leadNumber = `ZJ-${new Date().getFullYear()}-${String(100000 + (randBuf[0] % 900000))}`;
            const verifiedGeo = verified
              ? {
                  status: verified.status,
                  source: verified.source || 'arcgis',
                  address: {
                    line: verified.line,
                    city: verified.city,
                    state: verified.state || payload.state || 'AL',
                    zip: verified.zip,
                    lat: verified.lat,
                    lng: verified.lng,
                    countyFips: verified.countyFips || '',
                    countyName: verified.countyName || ''
                  }
                }
              : null;

            // 4. Primary 24/7 Cloud Bridge submission (encrypted storage + native installed-PWA Web Push + instant SSE live sync)
            let handledByBridge = false;
            if (cloudBridgeUrl) {
              try {
                const bridgeRes = await fetch(`${cloudBridgeUrl}/api/public/submit`, {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                    Accept: 'application/json',
                    'X-Idempotency-Key': idempotencyKey
                  },
                  body: JSON.stringify({
                    leadNumber,
                    inquiry: { ...payload, expectedFiles: relayMedia.length },
                    verifiedGeo,
                    media: relayMedia
                  })
                });
                const bridgeCt = bridgeRes.headers.get('content-type') || '';
                const bridgeData = bridgeCt.includes('application/json') ? await bridgeRes.json() : {};
                if (bridgeRes.ok && bridgeData.ok !== false) {
                  savedInquiry = {
                    leadId: bridgeData.leadId || idempotencyKey,
                    leadNumber: bridgeData.leadNumber || leadNumber,
                    uploadToken: 'cloud-relay'
                  };
                  handledByBridge = true;
                } else if (bridgeRes.status === 400 || bridgeRes.status === 422) {
                  if (bridgeData.fieldErrors && typeof bridgeData.fieldErrors === 'object') {
                    let firstStep = TOTAL;
                    for (const [k, msg] of Object.entries(bridgeData.fieldErrors as Record<string, string>)) {
                      if (k === 'pickupAddress' && verified) resetAddress();
                      setErr(k, msg);
                      firstStep = Math.min(firstStep, stepForField[k] || TOTAL);
                    }
                    if (firstStep !== step) goTo(firstStep);
                    showStatus('error', 'Please fix the highlighted fields and try again.');
                    return;
                  }
                  showStatus('error', esc(bridgeData.error || 'Please double-check your details and try again.'));
                  return;
                }
              } catch {
                // Fall back to E2E sealed relay below if Cloud Bridge is temporarily unreachable
              }
            }

            if (handledByBridge) {
              await finalize();
              return;
            }

            if (!relayTopic || !relayPubKey) {
              throw new Error('Cloud submission service is temporarily unreachable');
            }

            const sealedEnvelope = await encryptSealedForOwner(
              {
                leadNumber,
                submittedAt: new Date().toISOString(),
                inquiry: { ...payload, expectedFiles: relayMedia.length },
                verifiedGeo,
                media: relayMedia
              },
              relayPubKey
            );

            const alertSummary = [
              `${payload.city || 'Mobile'}, ${payload.state || 'AL'}`,
              `${payload.requestedService}${payload.estimatedQuantity ? ` (${payload.estimatedQuantity})` : ''}`,
              relayMedia.length ? `${relayMedia.length} file(s) attached` : 'No photos'
            ].join(' · ');

            const qs = new URLSearchParams({
              title: `New Zoiris Pickup Request (${leadNumber})`,
              message: `${alertSummary} - Tap to open Zoiris App`,
              priority: 'high',
              tags: 'truck,bell',
              filename: 'zoiris-lead.enc',
              click: relayClick
            });

            const relayRes = await fetch(`${relayUrl}/${encodeURIComponent(relayTopic)}?${qs.toString()}`, {
              method: 'POST',
              body: JSON.stringify(sealedEnvelope)
            });
            if (!relayRes.ok) {
              throw new Error(`Cloud dispatch HTTP ${relayRes.status}`);
            }

            savedInquiry = { leadId: idempotencyKey, leadNumber, uploadToken: 'cloud-relay' };
            await finalize();
            return;
          }

          const data = ct.includes('application/json') ? await res!.json() : {};
          if (!res!.ok || data.ok === false) {
            if (data.fieldErrors && typeof data.fieldErrors === 'object') {
              let firstStep = TOTAL;
              for (const [k, msg] of Object.entries(data.fieldErrors as Record<string, string>)) {
                if (k === 'pickupAddress' && verified) resetAddress();
                setErr(k, msg);
                firstStep = Math.min(firstStep, stepForField[k] || TOTAL);
              }
              if (firstStep !== step) goTo(firstStep);
              showStatus('error', `Please fix the highlighted ${firstStep === step ? 'fields' : 'step'} — ${esc(data.error || 'something needs a second look')}.`);
              return;
            }
            throw new Error(data.error || `HTTP ${res!.status}`);
          }
          savedInquiry = { leadId: data.leadId || 'external', leadNumber: data.leadNumber || 'SUBMITTED', uploadToken: data.uploadToken || '' };
        }

        const pending = queuedMedia.filter((m) => m.state !== 'uploaded');
        if (pending.length && savedInquiry.uploadToken) {
          let all = true;
          for (const item of pending) if (!(await uploadOne(item, savedInquiry.uploadToken))) all = false;
          if (!all) {
            goTo(2);
            showStatus('error', `Your request <strong>${esc(savedInquiry.leadNumber)}</strong> is saved — but a file didn't upload. Tap <strong>Retry</strong> on it, or call <a href="tel:+12519308621">${PHONE}</a>.`);
            return;
          }
        }
        await finalize();
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Unable to send request.';
        showStatus('error', `Sorry, your request could not be sent (${esc(msg)}). Nothing was booked — please try again or call <a href="tel:+12519308621">${PHONE}</a>.`);
      } finally {
        submitBtn.disabled = false;
        submitLabel.textContent = 'Send my request';
      }
    });

    syncCategories();
    syncTruck();
    syncReveals();
    restoreDraft();
    if (!verifyEndpoint && !suggestEndpoint) enterManual('Type your address below.');
  });
</script>

